<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="defaultprofile.json" />
    <None Remove="DeviceButtonMap.json" />
    <None Remove="DeviceMap.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="defaultprofile.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="DeviceButtonMap.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="DeviceMap.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <!-- Only the managed bindings are used. The package's build asset would also copy its bundled SDL2.dll (2.0.20)
         and unused SDL2_image/mixer/ttf natives; build/Sdl2.targets supplies the one SDL2.dll that ships. -->
    <PackageReference Include="Sayers.SDL2.Core" Version="1.0.11" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameControllerForZwift.Gamepad.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\GameControllerForZwift.Core\GameControllerForZwift.Core.csproj" />
  </ItemGroup>

  <Import Project="..\..\..\build\Sdl2.targets" />

</Project>
