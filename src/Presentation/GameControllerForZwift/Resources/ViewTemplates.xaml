<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GameControllerForZwift.UI.WPF.ViewModels"
                    xmlns:views="clr-namespace:GameControllerForZwift.UI.WPF.Views">
    <!-- View model first navigation: the shell shows the current view model and these templates pick its view. -->
    <DataTemplate DataType="{x:Type vm:ControllerSetupViewModel}">
        <views:ControllerSetupPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutPageViewModel}">
        <views:AboutPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsPage />
    </DataTemplate>
</ResourceDictionary>
