<Application x:Class="GameControllerForZwift.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameControllerForZwift">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
                <ResourceDictionary Source="Resources/Space.xaml" />
                <!-- Replaced by LayoutService when the navigation layout changes (docs/spec/ux/style-system.md). -->
                <ResourceDictionary Source="Resources/Layout.Desktop.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Images.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
                <ResourceDictionary Source="Resources/Surfaces.xaml" />
                <ResourceDictionary Source="Resources/Components.xaml" />
                <ResourceDictionary Source="Resources/ButtonsScreen.xaml" />
                <ResourceDictionary Source="Resources/Document.xaml" />
                <ResourceDictionary Source="Resources/Shell.xaml" />
                <!-- Replaced at startup by ThemeService, which keeps the tokens for the chosen appearance last. -->
                <ResourceDictionary Source="Resources/Theme/Tokens.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
