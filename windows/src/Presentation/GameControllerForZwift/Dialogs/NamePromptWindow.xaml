<Window x:Class="GameControllerForZwift.UI.WPF.Dialogs.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
        Style="{StaticResource Dialog.Window}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}"
        AutomationProperties.AutomationId="NamePromptDialog">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Dialog.Body}">
            <controls:Stack Gap="{StaticResource Space.12}">
                <TextBlock
                    x:Name="HeadingText"
                    Style="{StaticResource Text.Title}"
                    AutomationProperties.AutomationId="NamePromptHeading"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    x:Name="MessageText"
                    Style="{StaticResource Text.Body}"
                    AutomationProperties.AutomationId="NamePromptMessage" />
                <TextBox
                    x:Name="NameTextBox"
                    MaxLength="200"
                    TextChanged="NameTextBox_TextChanged"
                    AutomationProperties.AutomationId="ConfigurationNameTextBox"
                    AutomationProperties.Name="Configuration name"
                    AutomationProperties.LabeledBy="{Binding ElementName=MessageText}" />
                <TextBlock
                    x:Name="ValidationText"
                    Foreground="{DynamicResource Brush.err}"
                    Style="{StaticResource Text.Caption}"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="ConfigurationNameValidationText"
                    AutomationProperties.LiveSetting="Polite" />
            </controls:Stack>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <UniformGrid Rows="1" Columns="2">
                <Button
                    x:Name="OkButton"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource Dialog.ButtonCellPrimary}"
                    Click="OkButton_Click"
                    AutomationProperties.AutomationId="NamePromptOkButton" />
                <Button
                    x:Name="CancelButton"
                    Style="{StaticResource Dialog.ButtonCell}"
                    Content="Cancel"
                    IsCancel="True"
                    AutomationProperties.AutomationId="NamePromptCancelButton" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
