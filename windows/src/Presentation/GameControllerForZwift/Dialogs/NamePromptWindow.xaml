<Window x:Class="GameControllerForZwift.UI.WPF.Dialogs.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}"
        AutomationProperties.AutomationId="NamePromptDialog">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,24">
            <TextBlock
                x:Name="HeadingText"
                Margin="0,0,0,12"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="NamePromptHeading"
                AutomationProperties.HeadingLevel="Level1" />
            <TextBlock
                x:Name="MessageText"
                Margin="0,0,0,12"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="NamePromptMessage" />
            <TextBox
                x:Name="NameTextBox"
                MaxLength="200"
                TextChanged="NameTextBox_TextChanged"
                AutomationProperties.AutomationId="ConfigurationNameTextBox"
                AutomationProperties.Name="Configuration name"
                AutomationProperties.LabeledBy="{Binding ElementName=MessageText}" />
            <TextBlock
                x:Name="ValidationText"
                Margin="0,8,0,0"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="ConfigurationNameValidationText"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="24"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <UniformGrid Rows="1" Columns="2">
                <Button
                    x:Name="OkButton"
                    Margin="0,0,6,0" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    Click="OkButton_Click"
                    AutomationProperties.AutomationId="NamePromptOkButton" />
                <Button
                    x:Name="CancelButton"
                    Margin="6,0,0,0" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Content="Cancel"
                    IsCancel="True"
                    AutomationProperties.AutomationId="NamePromptCancelButton" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
