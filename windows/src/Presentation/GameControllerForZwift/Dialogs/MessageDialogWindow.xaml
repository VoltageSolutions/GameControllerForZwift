<Window x:Class="GameControllerForZwift.UI.WPF.Dialogs.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AutomationProperties.AutomationId="MessageDialog">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,24">
            <TextBlock
                x:Name="HeadingText"
                Margin="0,0,0,12"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="MessageDialogHeading"
                AutomationProperties.HeadingLevel="Level1" />
            <TextBlock
                x:Name="MessageText"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="MessageDialogMessage" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="24"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <UniformGrid x:Name="ButtonPanel" Rows="1">
                <Button
                    x:Name="PrimaryButton"
                    Margin="0,0,6,0" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    IsDefault="True"
                    Style="{StaticResource Button.Primary}"
                    Click="PrimaryButton_Click"
                    AutomationProperties.AutomationId="MessageDialogPrimaryButton" />
                <Button
                    x:Name="SecondaryButton"
                    Margin="6,0,6,0" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Click="SecondaryButton_Click"
                    AutomationProperties.AutomationId="MessageDialogSecondaryButton" />
                <Button
                    x:Name="CloseButton"
                    Margin="6,0,0,0" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    IsCancel="True"
                    AutomationProperties.AutomationId="MessageDialogCloseButton" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
