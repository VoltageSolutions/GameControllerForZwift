<Window x:Class="GameControllerForZwift.UI.WPF.Dialogs.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
        Style="{StaticResource Dialog.Window}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="MessageDialog">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Dialog.Body}">
            <controls:Stack Gap="{StaticResource Space.12}">
                <TextBlock
                    x:Name="HeadingText"
                    Style="{StaticResource Text.Title}"
                    AutomationProperties.AutomationId="MessageDialogHeading"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    x:Name="MessageText"
                    Style="{StaticResource Text.Body}"
                    AutomationProperties.AutomationId="MessageDialogMessage" />
            </controls:Stack>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Dialog.Footer}">
            <UniformGrid x:Name="ButtonPanel" Rows="1">
                <Button
                    x:Name="PrimaryButton"
                    IsDefault="True"
                    Style="{StaticResource Dialog.ButtonCellPrimary}"
                    Click="PrimaryButton_Click"
                    AutomationProperties.AutomationId="MessageDialogPrimaryButton" />
                <Button
                    x:Name="SecondaryButton"
                    Style="{StaticResource Dialog.ButtonCell}"
                    Click="SecondaryButton_Click"
                    AutomationProperties.AutomationId="MessageDialogSecondaryButton" />
                <Button
                    x:Name="CloseButton"
                    Style="{StaticResource Dialog.ButtonCell}"
                    IsCancel="True"
                    AutomationProperties.AutomationId="MessageDialogCloseButton" />
            </UniformGrid>
        </Border>
    </Grid>
</Window>
