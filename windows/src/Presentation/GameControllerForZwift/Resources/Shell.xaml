<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization">

    <!-- Styles of the window shell: the tabs, the More button and its menu, and the back button
         (docs/spec/ux/navigation.md). Colors come from the tokens, sizes from docs/spec/ux/visual-system.md. -->

    <!-- The tab lists. One per placement; the window shows the one that fits its width (UX-N-010). -->
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="AutomationProperties.Name" Value="{loc:Loc NavMain}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tab. Selected: surface fill, text color, weight 800. Not selected: muted, weight 600. -->
    <Style x:Key="NavItemBase" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
                <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
                <Setter Property="FontWeight" Value="ExtraBold" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- The Connections dot, drawn at the top right of the tab icon (UX-N-002, UX-V-004). -->
    <DataTemplate x:Key="NavIcon">
        <Grid Width="24" Height="24">
            <Path x:Name="Icon" Style="{StaticResource IconStroke}" />
            <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                     Fill="{DynamicResource Brush.accent-ink}"
                     Visibility="{Binding HasAlert, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Tab}" Value="Ride">
                <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Ride}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tab}" Value="Buttons">
                <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Buttons}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tab}" Value="Connections">
                <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.Connections}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Sidebar (wide window): icon and label in a row, 48 high. -->
    <Style x:Key="NavSidebarItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItemBase}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Height="48" Padding="16,0" CornerRadius="14" Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter ContentTemplate="{StaticResource NavIcon}" VerticalAlignment="Center" />
                            <TextBlock Margin="12,0,0,0" FontSize="16" VerticalAlignment="Center" Text="{Binding Label}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact rail (medium window): icon over label, 80 by 64. -->
    <Style x:Key="NavRailItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItemBase}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Width="80" Height="64" CornerRadius="20" Background="{TemplateBinding Background}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter ContentTemplate="{StaticResource NavIcon}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,2,0,0" FontSize="13" HorizontalAlignment="Center" Text="{Binding Label}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bottom bar (narrow window): three equal tabs, icon over label, 56 high. -->
    <Style x:Key="NavBottomItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItemBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Height="56" Margin="1,0" CornerRadius="28" Background="{TemplateBinding Background}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter ContentTemplate="{StaticResource NavIcon}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,2,0,0" FontSize="13" HorizontalAlignment="Center" Text="{Binding Label}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- More button: a 40 px neutral circle with a 48 px hit area (UX-N-005). -->
    <Style x:Key="MoreButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.bg}" />
        <Setter Property="Background" Value="{DynamicResource Brush.text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{TemplateBinding Background}" Effect="{DynamicResource Effect.shadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An item of the More menu: a pill with an icon and a label. -->
    <Style x:Key="MenuPill" TargetType="Button">
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="16,0,20,0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" CornerRadius="26" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" Effect="{DynamicResource Effect.shadow}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.surface-2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Back button of a pushed screen (UX-N-016): a 48 px circle. -->
    <Style x:Key="BackButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" CornerRadius="24" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource Brush.surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimize, maximize, and close. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Area" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Area" Property="Background" Value="{DynamicResource Brush.surface-2}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close turns the system red on hover, like other Windows apps. -->
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Area" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Area" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
