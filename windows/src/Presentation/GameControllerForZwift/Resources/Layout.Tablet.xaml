<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Layout tokens for the tablet size class (docs/spec/ux/style-system.md, docs/spec/ux/visual-system.md, Layout and
         spacing and Type). The three Layout.*.xaml files hold the same keys. LayoutService swaps them when the
         navigation layout changes, and screens read them with DynamicResource. LayoutSpecTests compares them with the spec. -->

    <!-- Page: padding inside the scroll area, and the room the floating bottom bar needs (UX-V-051, UX-V-052). -->
    <Thickness x:Key="Layout.PagePadding">48,32,48,48</Thickness>
    <sys:Double x:Key="Layout.NavClearance">0</sys:Double>
    <Thickness x:Key="Layout.BackMargin">48,32,0,0</Thickness>

    <!-- Gaps and padding. -->
    <sys:Double x:Key="Layout.SectionGap">32</sys:Double>
    <sys:Double x:Key="Layout.LabelGap">8</sys:Double>
    <sys:Double x:Key="Layout.RowGap">12</sys:Double>
    <sys:Double x:Key="Layout.CardGap">24</sys:Double>
    <Thickness x:Key="Layout.CardPadding">32,32,32,32</Thickness>
    <Thickness x:Key="Layout.RowPadding">20,12,20,12</Thickness>
    <sys:Double x:Key="Layout.ButtonGap">12</sys:Double>

    <!-- Status chip (UX-V-056). -->
    <sys:Double x:Key="Layout.ChipHeight">40</sys:Double>
    <Thickness x:Key="Layout.ChipPadding">16,0,16,0</Thickness>

    <!-- Type roles by size class (UX-V-050 and the type table). -->
    <sys:Double x:Key="Layout.PageTitleSize">48</sys:Double>
    <sys:Double x:Key="Layout.PageTitleLineHeight">53</sys:Double>
    <sys:Double x:Key="Layout.DisplaySize">52</sys:Double>
    <sys:Double x:Key="Layout.DisplayLineHeight">56</sys:Double>
    <sys:Double x:Key="Layout.ReadoutSize">64</sys:Double>
    <sys:Double x:Key="Layout.TitleSize">28</sys:Double>
    <sys:Double x:Key="Layout.BodySize">18</sys:Double>
    <sys:Double x:Key="Layout.CaptionSize">15</sys:Double>

    <!-- The More button and its menu, over the content area (UX-N-004). -->
    <Thickness x:Key="Layout.MoreMargin">0,12,16,0</Thickness>
    <Thickness x:Key="Layout.MenuMargin">0,72,16,0</Thickness>

</ResourceDictionary>
