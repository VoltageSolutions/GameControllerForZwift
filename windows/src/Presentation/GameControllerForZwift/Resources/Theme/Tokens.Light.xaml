<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light color tokens from docs/spec/ux/visual-system.md. Screens use the Brush.* keys, never raw colors.
         TokenSpecTests fails when a value here differs from the spec table. -->
    <Color x:Key="Color.bg">#FAF8F4</Color>
    <Color x:Key="Color.surface">#FFFFFF</Color>
    <Color x:Key="Color.surface-2">#F1EDE6</Color>
    <Color x:Key="Color.text">#1F1B16</Color>
    <Color x:Key="Color.muted">#655E55</Color>
    <Color x:Key="Color.accent">#ED7600</Color>
    <Color x:Key="Color.accent-ink">#A55200</Color>
    <Color x:Key="Color.on-accent">#1F1B16</Color>
    <Color x:Key="Color.focus">#1F5FCC</Color>
    <Color x:Key="Color.ok">#1E7A4C</Color>
    <Color x:Key="Color.err">#B3261E</Color>
    <Color x:Key="Color.pad">#E6E0D5</Color>
    <Color x:Key="Color.pad-2">#D5CDBF</Color>
    <Color x:Key="Color.pad-key">#F6F2EB</Color>

    <SolidColorBrush x:Key="Brush.bg" Color="{StaticResource Color.bg}" />
    <SolidColorBrush x:Key="Brush.surface" Color="{StaticResource Color.surface}" />
    <SolidColorBrush x:Key="Brush.surface-2" Color="{StaticResource Color.surface-2}" />
    <SolidColorBrush x:Key="Brush.text" Color="{StaticResource Color.text}" />
    <SolidColorBrush x:Key="Brush.muted" Color="{StaticResource Color.muted}" />
    <SolidColorBrush x:Key="Brush.accent" Color="{StaticResource Color.accent}" />
    <SolidColorBrush x:Key="Brush.accent-ink" Color="{StaticResource Color.accent-ink}" />
    <SolidColorBrush x:Key="Brush.on-accent" Color="{StaticResource Color.on-accent}" />
    <SolidColorBrush x:Key="Brush.focus" Color="{StaticResource Color.focus}" />
    <SolidColorBrush x:Key="Brush.ok" Color="{StaticResource Color.ok}" />
    <SolidColorBrush x:Key="Brush.err" Color="{StaticResource Color.err}" />
    <SolidColorBrush x:Key="Brush.pad" Color="{StaticResource Color.pad}" />
    <SolidColorBrush x:Key="Brush.pad-2" Color="{StaticResource Color.pad-2}" />
    <SolidColorBrush x:Key="Brush.pad-key" Color="{StaticResource Color.pad-key}" />

    <!-- Fluent theme keys, pointed at the tokens so Fluent controls and the existing screens use the same colors. -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Color.text}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Color.muted}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Color.muted}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Color.surface}" />
    <SolidColorBrush x:Key="ControlExampleDisplayBrush" Color="{StaticResource Color.surface}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource Color.bg}" />
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource Color.surface}" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Color.bg}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Color.bg}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Color.accent}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Color.accent}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Color.accent}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource Color.accent}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Color.accent-ink}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource Color.accent-ink}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource Color.accent-ink}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Color.on-accent}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource Color.on-accent}" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource Color.focus}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource Color.ok}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource Color.err}" />
    <!-- Surfaces are separated by color and spacing, not outlines (UX-V-022). -->
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />

    <!-- Elevation (UX-V-023): a soft shadow in light mode only. -->
    <DropShadowEffect x:Key="Effect.shadow" Color="#3C2814" Direction="270" ShadowDepth="2" BlurRadius="24" Opacity="0.12" />
    <!-- Dims the screen behind the More menu. -->
    <SolidColorBrush x:Key="Brush.scrim" Color="#40281E14" />
</ResourceDictionary>
