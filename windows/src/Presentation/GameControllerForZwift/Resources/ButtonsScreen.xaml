<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
                    xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization">

    <!-- Parts of the Buttons screen (docs/spec/screens/buttons.md): a mapping row, the two tabs, and the items of the
         function picker. They take every size from tokens. -->

    <!-- A row: the input's chip, what it does, a Changed mark, and a chevron (SCR-BTN-003). A row with no action uses
         the disabled row look: surface-2, muted text, no outline, no shadow (UX-V-046). -->
    <Style x:Key="Buttons.RowStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill" CornerRadius="{StaticResource Radius.Row}" Background="{DynamicResource Brush.surface}" Effect="{DynamicResource Effect.shadow}" />
                        <Border x:Name="Tint" CornerRadius="{StaticResource Radius.Row}" Background="{DynamicResource Brush.accent}" Opacity="0.22" Visibility="Collapsed" />
                        <Border x:Name="Film" CornerRadius="{StaticResource Radius.Row}" Background="{DynamicResource Brush.text}" Opacity="0" />
                        <Grid Margin="{DynamicResource Layout.RowPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource Gap.16}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource Gap.12}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource Gap.12}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Chip" Style="{StaticResource Chip.Key}">
                                <TextBlock x:Name="ChipText" Style="{StaticResource Text.Chip}" Text="{Binding Chip}" />
                            </Border>
                            <TextBlock x:Name="FunctionText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.RowTitle}"
                                       Text="{Binding FunctionTitle}" />
                            <controls:Stack x:Name="ChangedMark" Grid.Column="4" Orientation="Horizontal" Gap="{StaticResource Space.8}" VerticalAlignment="Center"
                                            Visibility="{Binding IsChanged, Converter={StaticResource BooleanToVisibility}}">
                                <Ellipse Width="{StaticResource Size.StatusDot}" Height="{StaticResource Size.StatusDot}" Fill="{DynamicResource Brush.accent}" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Mark}" Text="{loc:Loc ButtonsChanged}" />
                            </controls:Stack>
                            <Path Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Chevron}"
                                  Stroke="{DynamicResource Brush.text}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Film" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Film" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFree}" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.surface-2}" />
                            <Setter TargetName="Fill" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.surface}" />
                            <Setter TargetName="FunctionText" Property="Foreground" Value="{DynamicResource Brush.muted}" />
                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.muted}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Tint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.accent}" />
                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.on-accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPressed}" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.accent}" />
                            <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.on-accent}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The track of a segmented choice made of radio buttons, such as the two tabs (UX-V-048). It fits the page width:
         the pills share the track and their words wrap. -->
    <Style x:Key="Segmented.Track" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Buttons.TabStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="{StaticResource Size.TabMinWidth}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Figtree}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="Transparent" />
                        <ContentPresenter Margin="20,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.surface}" />
                            <Setter TargetName="Fill" Property="Effect" Value="{DynamicResource Effect.shadow}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An item of the function picker. The chosen item is on surface-2 with a check mark, not an accent wash. -->
    <Style x:Key="Buttons.FunctionStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chosen" CornerRadius="14" Background="{DynamicResource Brush.surface-2}" Visibility="Collapsed" />
                        <Border x:Name="Film" CornerRadius="14" Background="{DynamicResource Brush.text}" Opacity="0" />
                        <Grid Margin="12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource Gap.12}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:Stack VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.RowTitle}" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource Text.RowCaption}" Text="{Binding Hint}" />
                            </controls:Stack>
                            <Path x:Name="CheckMark" Grid.Column="2" Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Check}"
                                  Stroke="{DynamicResource Brush.text}" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Film" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chosen" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The function picker sheet: a panel on the right edge of the window over a scrim (SCR-BTN-004). -->
    <Style x:Key="Sheet.Panel" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Width" Value="{StaticResource Size.SheetWidth}" />
        <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sheet}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Sheet}" />
    </Style>

</ResourceDictionary>
