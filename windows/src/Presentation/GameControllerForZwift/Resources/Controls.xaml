<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:GameControllerForZwift.UI.WPF.Converters"
                    xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls">

    <!-- Shared controls: buttons, dropdowns, text boxes, checkboxes, switches, and radio buttons
         (docs/spec/ux/visual-system.md, Buttons and Fields and choices). Colors come from the tokens.
         The implicit styles restyle every control of that type in the app; the keyed styles are for a specific role. -->

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <converters:PillRadiusConverter x:Key="PillRadius" />

    <!-- Focus ring: 3 px, 2 px outside the control (UX-V-021). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-5" BorderThickness="3" CornerRadius="24" BorderBrush="{DynamicResource Brush.focus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The focus ring for fields, with the field's own corners. -->
    <Style x:Key="FieldFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-5" BorderThickness="3" CornerRadius="19" BorderBrush="{DynamicResource Brush.focus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A 24 by 24 icon drawn with a 2 px round stroke in the color of the control around it. -->
    <Style x:Key="IconStroke" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <!-- ===== Buttons (UX-V-026 to UX-V-033) ===== -->

    <!-- A pill that hugs its label. Hover and press lay a faint text-colored film over the fill. A disabled button keeps
         its place, with the surface-2 fill and the muted label (SCR-BTN-014). -->
    <ControlTemplate x:Key="PillButtonTemplate" TargetType="ButtonBase">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Fill" Background="{TemplateBinding Background}"
                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PillRadius}}" />
            <Border x:Name="Film" Background="{DynamicResource Brush.text}" Opacity="0"
                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PillRadius}}" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Film" Property="Opacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Film" Property="Opacity" Value="0.16" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.surface-2}" />
                <Setter TargetName="Film" Property="Opacity" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Row, dialog, and secondary actions: 48 high, 24 padding, label 16 weight 700. -->
    <Style x:Key="Button.Secondary" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource PillButtonTemplate}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Figtree}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    </Style>

    <!-- Standard: 56 high, 28 padding, label 17 weight 700. -->
    <Style x:Key="Button.Standard" TargetType="ButtonBase" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <!-- The screen's one main action (UX-V-001, UX-V-033): 60 high, accent fill, on-accent label weight 800, at least
         160 wide. Its dark label and shape identify it in light mode too (UX-V-005). -->
    <Style x:Key="Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="60" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Background" Value="{DynamicResource Brush.accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.on-accent}" />
    </Style>

    <!-- Action row: a row-sized button with a title, a line under it, and a chevron or external-link mark. At least 64 high,
         radius 20, on the surface color with the soft shadow (UX-V-017, UX-V-022, UX-V-023). -->
    <Style TargetType="controls:ActionRow">
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Figtree}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ActionRow">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill" CornerRadius="20" Background="{DynamicResource Brush.surface}" Effect="{DynamicResource Effect.shadow}" />
                        <Border x:Name="Film" CornerRadius="20" Background="{DynamicResource Brush.text}" Opacity="0" IsHitTestVisible="False" />
                        <Grid MinHeight="44" Margin="20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="EyebrowText" Text="{TemplateBinding Eyebrow}" FontSize="14" Foreground="{DynamicResource Brush.muted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.text}" />
                                <TextBlock x:Name="DescriptionText" Margin="0,2,0,0" Text="{TemplateBinding Description}" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.muted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding TrailingText}" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.muted}" />
                            <Viewbox x:Name="Mark" Width="18" Height="18" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Path x:Name="MarkPath" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource Brush.text}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Trailing" Value="Chevron">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MarkPath" Property="Data" Value="{StaticResource Icon.Chevron}" />
                        </Trigger>
                        <Trigger Property="Trailing" Value="External">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="MarkPath" Property="Data" Value="{StaticResource Icon.External}" />
                            <Setter TargetName="Mark" Property="Width" Value="16" />
                            <Setter TargetName="Mark" Property="Height" Value="16" />
                            <Setter TargetName="MarkPath" Property="StrokeThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Film" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Film" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.surface-2}" />
                            <Setter TargetName="Fill" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.muted}" />
                            <Setter TargetName="MarkPath" Property="Stroke" Value="{DynamicResource Brush.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger action row: the title is in the error color. -->
    <Style x:Key="ActionRow.Danger" TargetType="controls:ActionRow" BasedOn="{StaticResource {x:Type controls:ActionRow}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ActionRow">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill" CornerRadius="20" Background="{DynamicResource Brush.surface}" Effect="{DynamicResource Effect.shadow}" />
                        <Border x:Name="Film" CornerRadius="20" Background="{DynamicResource Brush.text}" Opacity="0" IsHitTestVisible="False" />
                        <StackPanel MinHeight="44" Margin="20,10" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.err}" />
                            <TextBlock Margin="0,2,0,0" Text="{TemplateBinding Description}" FontSize="14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Film" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Film" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.surface-2}" />
                            <Setter TargetName="Fill" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented choice: a list box drawn as a track of pills; the chosen pill is raised (UX-V-016). -->
    <Style x:Key="Segmented" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Height" Value="48" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FontFamily" Value="{DynamicResource Font.Figtree}" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid SnapsToDevicePixels="True">
                                    <Border x:Name="Fill" CornerRadius="22" Background="Transparent" />
                                    <ContentPresenter Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.surface}" />
                                        <Setter TargetName="Fill" Property="Effect" Value="{DynamicResource Effect.shadow}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="26" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An icon-only button: a 48 px circle. It needs a screen reader name. -->
    <Style x:Key="Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Width" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Every other button in the app is a secondary pill. -->
    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />

    <!-- Content for a button with an icon: an 18 to 20 px icon, 10 px before the label (UX-V-026). -->
    <Style x:Key="ButtonIcon" TargetType="Path" BasedOn="{StaticResource IconStroke}">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Fields (UX-V-039, UX-V-040) ===== -->

    <Geometry x:Key="ChevronDown">M7,10 L12,15 L17,10</Geometry>

    <ControlTemplate x:Key="ComboBoxToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Field" CornerRadius="14" Background="{TemplateBinding Background}">
            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Width="24" Height="24"
                  Data="{StaticResource ChevronDown}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Stroke="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Field" Property="Background" Value="{DynamicResource Brush.surface}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Padding" Value="16,0,48,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Figtree}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FieldFocusRing}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <!-- Few items, so the list scrolls smoothly by pixel. -->
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="MaxDropDownHeight" Value="360" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <!-- No style, so the Fluent theme's toggle button setters cannot change the field's size. -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Style="{x:Null}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Template="{StaticResource ComboBoxToggleTemplate}"
                                      Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- The selected item, centered vertically whatever the font's line metrics (UX-V-039). -->
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" VerticalOffset="-2" HorizontalOffset="-8"
                               Focusable="False" PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <!-- The margin leaves room for the light-mode shadow. -->
                            <Border Margin="8" Padding="6" CornerRadius="16" Background="{DynamicResource Brush.surface}" Effect="{DynamicResource Effect.shadow}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dropdown item. The selected item is bold (UX-V-040). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Item" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.surface-2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="48" />
        <!-- With the text box's own inner margin, this lines the text up with a dropdown's 16 px. -->
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.focus}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Figtree}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- The ring shows whenever the text box has focus, so you always see where you type. It is a separate layer
                     so the fill keeps the full size of the field. -->
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border CornerRadius="14" Background="{TemplateBinding Background}" />
                        <Border x:Name="Ring" CornerRadius="14" BorderThickness="3" BorderBrush="{TemplateBinding BorderBrush}" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Choices (UX-V-041, UX-V-042) ===== -->

    <!-- Checkbox: a 22 px box. Unchecked, a 2 px muted outline makes it visible at 3:1 (UX-V-043). Checked, it fills
         with the text color and shows a check in the background color. -->
    <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Figtree}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center" Background="{TemplateBinding Background}"
                                BorderThickness="2" BorderBrush="{DynamicResource Brush.muted}">
                            <Path x:Name="Check" Width="16" Height="16" Margin="-2" Data="M3,8.5 L6.5,12 L13,4.5" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{DynamicResource Brush.bg}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.text}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.text}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Switch: a checkbox drawn as a 44 by 24 track. On, the track fills with the text color and the knob moves right.
         The label sits on the left, the switch on the right, as in a settings row. -->
    <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Margin="0,0,16,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        <Border x:Name="Track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" VerticalAlignment="Center" Background="{TemplateBinding Background}"
                                BorderThickness="2" BorderBrush="{DynamicResource Brush.muted}">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Brush.muted}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.text}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.text}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.bg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
                            <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio button: a 22 px circle. Selected, a 10 px dot in the text color. -->
    <Style TargetType="RadioButton">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Figtree}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}" StrokeThickness="2" Stroke="{DynamicResource Brush.muted}" />
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Brush.text}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
