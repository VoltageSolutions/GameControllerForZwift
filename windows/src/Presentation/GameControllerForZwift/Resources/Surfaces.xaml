<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces (docs/spec/ux/visual-system.md, Spacing and Surfaces). Color, spacing, and rounded corners separate
         them, never outlines (UX-V-022). The shadow token is soft in light mode and absent in dark mode (UX-V-023). -->

    <!-- Card: radius 24 (UX-V-018). -->
    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{DynamicResource Effect.shadow}" />
    </Style>

    <!-- Row: radius 18 (UX-V-017), at least 64 high. -->
    <Style x:Key="Surface.Row" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Effect" Value="{DynamicResource Effect.shadow}" />
    </Style>

    <!-- Panel: radius 32 (UX-V-019), for the large areas of a tablet or desktop layout. -->
    <Style x:Key="Surface.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Padding" Value="32" />
        <Setter Property="Effect" Value="{DynamicResource Effect.shadow}" />
    </Style>

    <!-- Chip or keycap: a 32 px pill on surface-2 (UX-V-016). -->
    <Style x:Key="Surface.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
