<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:GameControllerForZwift.UI.WPF.Helpers"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">


    <!--Typography-->

    <!-- Figtree (UX-V-011). The app ships weights 400 to 800 in Assets/Fonts. Fluent control templates read
         ContentControlThemeFontFamily, so every control uses Figtree too. -->
    <FontFamily x:Key="Font.Figtree">pack://application:,,,/GameControllerForZwift;component/Assets/Fonts/#Figtree</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/GameControllerForZwift;component/Assets/Fonts/#Figtree</FontFamily>
    
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">20</sys:Double>
    <sys:Double x:Key="TitleFontSize">28</sys:Double>
    <sys:Double x:Key="TitleLargeFontSize">40</sys:Double>

    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
    </Style>
    <Style
        x:Key="CaptionTextBlockStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style
        x:Key="BodyTextBlockStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style
        x:Key="BodyStrongTextBlockStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock" />
    <Style
        x:Key="SubtitleTextBlockStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
    </Style>
    <Style
        x:Key="TitleTextBlockStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
    </Style>
    <Style
        x:Key="TitleLargeTextBlockStyle"
        BasedOn="{StaticResource BaseTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TitleLargeFontSize}" />
    </Style>

    <!-- Type roles (docs/spec/ux/visual-system.md, Type). A size that varies by size class comes from the Layout.* keys,
         so a screen gets the right size without checking the width. Headings are weight 800 and body text 400 to 600
         (UX-V-012). Every role uses tabular figures, so numbers do not jitter (UX-V-013). -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Figtree}" />
        <Setter Property="FontSize" Value="{DynamicResource Layout.BodySize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource Layout.CaptionSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
    </Style>
    <!-- Status words: caption size, semibold, always the text color. Only the dot carries the color (UX-V-057). -->
    <Style x:Key="Text.Status" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource Layout.CaptionSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource Layout.TitleSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="{DynamicResource Layout.DisplaySize}" />
        <Setter Property="LineHeight" Value="{DynamicResource Layout.DisplayLineHeight}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <!-- A screen title: 34 on phone, 48 on tablet and desktop (UX-V-050). -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="{DynamicResource Layout.PageTitleSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource Layout.PageTitleLineHeight}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <!-- The label over a group of rows: 17, weight 700, muted, 4 px of indent (UX-V-047). -->
    <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <!-- The lead paragraph of a screen, for example the pitch of Support: 20, muted. -->
    <Style x:Key="Text.Lead" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="29" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
    </Style>
    <!-- The title of a row: 17, weight 700 (UX-V-045). -->
    <Style x:Key="Text.RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- The line under a row title: 14, muted (UX-V-045). -->
    <Style x:Key="Text.RowCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
    </Style>
    <!-- A small mark beside a row, such as "Changed": 14, weight 700, in the accent text color. -->
    <Style x:Key="Text.Mark" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.accent-ink}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- A big live number, such as watts or gear. -->
    <Style x:Key="Text.Readout" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="{DynamicResource Layout.ReadoutSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A number over a label, such as "32 min". -->
    <Style x:Key="Text.Stat" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- The label of a key chip, such as RB. -->
    <Style x:Key="Text.Chip" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--Other-->

    <Style x:Key="ColorTilesPanelStyle" TargetType="{x:Type Border}">
        <Style.Setters>
            <Setter Property="Background" Value="{DynamicResource ControlExampleDisplayBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style.Setters>
    </Style>
</ResourceDictionary>