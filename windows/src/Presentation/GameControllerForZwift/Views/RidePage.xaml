<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.RidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
             AutomationProperties.AutomationId="RidePage">
    <UserControl.Resources>
        <!-- The panel of a list that wraps, with the row gap between items. -->
        <ItemsPanelTemplate x:Key="Ride.WrapPanel">
            <controls:Stack Orientation="Horizontal" Wrap="True" Gap="{DynamicResource Layout.RowGap}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="Ride.StepsPanel">
            <controls:Stack Gap="{StaticResource Space.8}" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <!-- docs/spec/screens/ride.md. Home, the riding view, and the ride summary share this page. -->
    <controls:ScreenPage>
        <Grid>
            <!-- Home (SCR-RIDE-001 to SCR-RIDE-015, SCR-RIDE-034, SCR-RIDE-035, SCR-RIDE-040). Two columns on a wide window. -->
            <controls:AdaptiveColumns x:Name="HomePanel" SideWidth="{StaticResource Size.SideColumn}" SideOffset="{StaticResource Space.40}"
                                      Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibility}}">
                <controls:Stack Gap="{DynamicResource Layout.SectionGap}">
                    <controls:Stack>
                        <controls:VoltageWordmark x:Name="Wordmark" Height="{StaticResource Space.32}" HorizontalAlignment="Left"
                                                  AutomationProperties.AutomationId="RideWordmark" AutomationProperties.Name="{loc:Loc RideWordmarkName}" />
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Foreground="{DynamicResource Brush.muted}" Text="{loc:Loc AppName}" />
                    </controls:Stack>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource Text.PageTitle}" Text="{Binding TitleText}"
                               AutomationProperties.AutomationId="RidePageTitle" AutomationProperties.HeadingLevel="Level1" />

                    <controls:Stack Gap="{DynamicResource Layout.RowGap}">
                        <controls:ActionRow x:Name="ChangeMappingButton" Trailing="Chevron"
                                            Eyebrow="{loc:Loc RideMappingLabel}" Title="{Binding MappingName}" TrailingText="{loc:Loc RideChangeMapping}"
                                            Command="{Binding ChangeMappingCommand}"
                                            AutomationProperties.AutomationId="RideChangeMappingButton" AutomationProperties.Name="{loc:Loc RideChangeMapping}" />

                        <!-- Zwift: the status, and while it is not connected the three steps and Pair with Zwift, in one card
                             (SCR-RIDE-005, SCR-RIDE-012, SCR-RIDE-013). -->
                        <Border x:Name="ZwiftCard" Style="{StaticResource Surface.Card}" AutomationProperties.AutomationId="RideZwiftCard">
                            <controls:Stack Gap="{DynamicResource Layout.CardGap}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{StaticResource Gap.12}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:StatusDot IsOk="{Binding IsZwiftConnected, Mode=OneWay}" />
                                    <TextBlock x:Name="ZwiftStatusText" Grid.Column="2" Style="{StaticResource Text.RowTitle}" VerticalAlignment="Center"
                                               Text="{Binding ZwiftStatusText}"
                                               AutomationProperties.AutomationId="RideZwiftStatus" AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Steps}" ItemsPanel="{StaticResource Ride.StepsPanel}" IsTabStop="False"
                                              Visibility="{Binding ShowPairWithZwift, Converter={StaticResource BooleanToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="PairWithZwiftButton" HorizontalAlignment="Left" Style="{StaticResource Button.Primary}"
                                        Visibility="{Binding ShowPairWithZwift, Converter={StaticResource BooleanToVisibility}}"
                                        Command="{Binding GoToConnectionsCommand}" Content="{loc:Loc RidePairWithZwift}"
                                        AutomationProperties.AutomationId="RidePairWithZwiftButton" />
                            </controls:Stack>
                        </Border>
                    </controls:Stack>
                </controls:Stack>

                <!-- The controller: its name and state, the two ways out without one, and the stats (SCR-RIDE-002, SCR-RIDE-003, SCR-RIDE-009). -->
                <Border x:Name="ControllerCard" Style="{StaticResource Surface.Panel}"
                        AutomationProperties.AutomationId="RideControllerCard" AutomationProperties.Name="{Binding ControllerText}">
                    <controls:Stack Gap="{DynamicResource Layout.CardGap}">
                        <controls:Stack Gap="{StaticResource Space.4}">
                            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding ControllerName}" AutomationProperties.LiveSetting="Polite" />
                            <controls:Stack Orientation="Horizontal" Gap="{StaticResource Space.8}" Visibility="{Binding HasController, Converter={StaticResource BooleanToVisibility}}">
                                <controls:StatusDot IsOk="True" />
                                <TextBlock Style="{StaticResource Text.Status}" VerticalAlignment="Center" Text="{Binding ControllerStateText}" />
                            </controls:Stack>
                        </controls:Stack>
                        <controls:Stack Gap="{DynamicResource Layout.ButtonGap}" Visibility="{Binding ShowNoControllerActions, Converter={StaticResource BooleanToVisibility}}">
                            <Button x:Name="UseDifferentControllerButton" Command="{Binding GoToConnectionsCommand}"
                                    Content="{loc:Loc ConnectionsPickerLabel}" AutomationProperties.AutomationId="RideUseDifferentControllerButton" />
                            <Button x:Name="PairBluetoothButton" Command="{Binding PairBluetoothCommand}"
                                    Content="{loc:Loc ConnectionsPairBluetooth}" AutomationProperties.AutomationId="RidePairBluetoothButton" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc ConnectionsUsbHint}"
                                       AutomationProperties.AutomationId="RideUsbHint" />
                        </controls:Stack>
                        <UniformGrid x:Name="StatsCard" Rows="1" Columns="3" Visibility="{Binding HasStats, Converter={StaticResource BooleanToVisibility}}"
                                     AutomationProperties.AutomationId="RideStats">
                            <controls:Stat Value="{Binding RidesValue}" Label="{Binding RidesLabel}" />
                            <controls:Stat Value="{Binding ShiftsValue}" Label="{Binding ShiftsLabel}" />
                            <controls:Stat Value="{Binding SinceValue}" Label="{Binding SinceLabel}" />
                        </UniformGrid>
                    </controls:Stack>
                </Border>
            </controls:AdaptiveColumns>

            <!-- Riding view (SCR-RIDE-016 to SCR-RIDE-028) -->
            <controls:Stack x:Name="RidingPanel" Gap="{DynamicResource Layout.CardGap}"
                            Visibility="{Binding IsRiding, Converter={StaticResource BooleanToVisibility}}">
                <controls:Stack Orientation="Horizontal" Wrap="True" Gap="{StaticResource Space.8}">
                    <controls:StatusChip IsOk="{Binding HasController, Mode=OneWay}" Text="{Binding ControllerChipText}" />
                    <controls:StatusChip IsOk="{Binding IsZwiftConnected, Mode=OneWay}" Text="{Binding ZwiftChipText}" />
                </controls:Stack>

                <controls:Stack>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc RideRidingWith}" />
                    <TextBlock Style="{StaticResource Text.Title}" Text="{Binding MappingName}" />
                </controls:Stack>

                <Border Style="{StaticResource Surface.Card}"
                        AutomationProperties.AutomationId="RideLastPress" AutomationProperties.Name="{Binding LastPressText}" AutomationProperties.LiveSetting="Polite">
                    <controls:Stack Gap="{StaticResource Space.12}">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc RideJustPressed}"
                                   AutomationProperties.HeadingLevel="Level1" />
                        <controls:Stack Orientation="Horizontal" Wrap="True" Gap="{StaticResource Space.16}">
                            <Border Style="{StaticResource Chip.Live}" Visibility="{Binding HasLastPress, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Style="{StaticResource Text.Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.on-accent}" Text="{Binding LastPressKey}" />
                            </Border>
                            <TextBlock x:Name="LastPressText" VerticalAlignment="Center" Style="{StaticResource Text.Readout}"
                                       Text="{Binding LastPressAction}" AutomationProperties.AutomationId="RideLastPressStatus" />
                        </controls:Stack>
                        <TextBlock x:Name="ShiftsThisRide" Style="{StaticResource Text.Caption}" Text="{Binding ShiftsThisRideText}" />
                    </controls:Stack>
                </Border>

                <Border x:Name="ProblemCard" Style="{StaticResource Surface.Card}"
                        Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibility}}"
                        AutomationProperties.AutomationId="RideProblem" AutomationProperties.LiveSetting="Assertive">
                    <controls:Stack Gap="{StaticResource Space.12}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource Gap.8}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StatusDot IsOk="False" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Text.RowTitle}" Text="{Binding ProblemTitle}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding ProblemBody}" />
                    </controls:Stack>
                </Border>
                <TextBlock x:Name="RecoveryText" Text="{Binding RecoveryText}"
                           AutomationProperties.AutomationId="RideRecovery" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl x:Name="QuickReference" ItemsSource="{Binding QuickReference}" ItemsPanel="{StaticResource Ride.WrapPanel}" IsTabStop="False"
                              AutomationProperties.Name="{loc:Loc RideQuickReference}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Surface.Row}" AutomationProperties.Name="{Binding Text}">
                                <controls:Stack Orientation="Horizontal" Gap="{StaticResource Space.12}" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Chip.Key}">
                                        <TextBlock Style="{StaticResource Text.Chip}" Text="{Binding Chip}" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.RowTitle}" Text="{Binding Function}" />
                                </controls:Stack>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:Stack>

            <!-- Ride finished (SCR-RIDE-029 to SCR-RIDE-032, SCR-RIDE-039) -->
            <controls:Stack x:Name="FinishedPanel" Gap="{DynamicResource Layout.CardGap}"
                            Visibility="{Binding IsFinished, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:Loc RideFinishedTitle}"
                           AutomationProperties.AutomationId="RideFinishedTitle" AutomationProperties.HeadingLevel="Level1" />
                <Border Style="{StaticResource Surface.Card}" AutomationProperties.AutomationId="RideSummary">
                    <UniformGrid Rows="1" Columns="3">
                        <controls:Stat Value="{Binding FinishedTimeValue}" Label="{Binding FinishedTimeLabel}" />
                        <controls:Stat Value="{Binding FinishedShiftsValue}" Label="{Binding FinishedShiftsLabel}" />
                        <controls:Stat Value="{Binding FinishedRidesValue}" Label="{Binding FinishedRidesLabel}" />
                    </UniformGrid>
                </Border>
                <Border x:Name="DonationAsk" Style="{StaticResource Surface.Card}"
                        Visibility="{Binding ShowDonationAsk, Converter={StaticResource BooleanToVisibility}}"
                        AutomationProperties.AutomationId="RideDonationAsk">
                    <controls:Stack Gap="{DynamicResource Layout.CardGap}">
                        <TextBlock Style="{StaticResource Text.Body}" Text="{loc:Loc RideAskPitch}" />
                        <controls:Stack Orientation="Horizontal" Wrap="True" Gap="{DynamicResource Layout.ButtonGap}">
                            <Button x:Name="ChipInButton" Style="{StaticResource Button.Primary}" Command="{Binding ChipInCommand}"
                                    Content="{loc:Loc SupportKofi}" AutomationProperties.AutomationId="RideChipInButton" />
                            <Button x:Name="MaybeLaterButton" Command="{Binding MaybeLaterCommand}"
                                    Content="{loc:Loc RideAskLater}" AutomationProperties.AutomationId="RideMaybeLaterButton" />
                        </controls:Stack>
                    </controls:Stack>
                </Border>
                <Button x:Name="DoneButton" HorizontalAlignment="Left" Command="{Binding DoneCommand}"
                        Content="{loc:Loc RideFinishedDone}" AutomationProperties.AutomationId="RideDoneButton" />
            </controls:Stack>
        </Grid>
    </controls:ScreenPage>
</UserControl>
