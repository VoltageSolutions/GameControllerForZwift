<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
             AutomationProperties.AutomationId="HelpPage">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="Help.RowsPanel">
            <controls:Stack Gap="{DynamicResource Layout.RowGap}" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <!-- docs/spec/screens/help.md. Two columns on a wide window, one column on a narrow one. -->
    <controls:ScreenPage>
        <controls:AdaptiveColumns SideWidth="{StaticResource Size.SideColumn}">
            <controls:Stack Gap="{DynamicResource Layout.SectionGap}">
                <TextBlock x:Name="PageTitle" Style="{StaticResource Text.PageTitle}" Text="{loc:Loc HelpTitle}"
                           AutomationProperties.AutomationId="HelpPageTitle" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock MaxWidth="{StaticResource Size.SideColumn}" HorizontalAlignment="Left" Style="{StaticResource Text.Lead}" Text="{loc:Loc HelpIntro}" />
            </controls:Stack>

            <controls:Stack Gap="{DynamicResource Layout.SectionGap}">
                <!-- Common problems, each with a short plain fix (SCR-HELP-001, SCR-HELP-002) -->
                <controls:Section Label="{loc:Loc HelpProblemsSection}">
                    <controls:Stack Gap="{DynamicResource Layout.RowGap}">
                        <controls:ActionRow x:Name="FindLinkButton" Title="{loc:Loc HelpProblemFindTitle}" Description="{loc:Loc HelpProblemFindFix}" Trailing="Chevron"
                                            Command="{Binding OpenConnectionsCommand}" AutomationProperties.AutomationId="HelpFindLink" />
                        <ItemsControl x:Name="Problems" ItemsSource="{Binding Problems}" ItemsPanel="{StaticResource Help.RowsPanel}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Surface.Row}">
                                        <controls:Stack Gap="{StaticResource Space.4}" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.RowTitle}" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Text.RowCaption}" Text="{Binding Fix}" />
                                        </controls:Stack>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:Stack>
                </controls:Section>

                <!-- The log folder, Report a problem, and Send feedback (SCR-HELP-003 to SCR-HELP-006) -->
                <controls:Section Label="{loc:Loc HelpContactSection}">
                    <controls:Stack Gap="{DynamicResource Layout.RowGap}">
                        <controls:ActionRow x:Name="OpenLogsButton" Title="{loc:Loc HelpOpenLogs}" Description="{loc:Loc HelpOpenLogsDescription}" Trailing="External"
                                            Command="{Binding OpenLogsFolderCommand}" AutomationProperties.AutomationId="HelpOpenLogsButton" />
                        <controls:ActionRow x:Name="ReportButton" Title="{loc:Loc HelpReport}" Description="{loc:Loc HelpReportDescription}" Trailing="External"
                                            Command="{Binding ReportProblemCommand}" AutomationProperties.AutomationId="HelpReportButton" />
                        <controls:ActionRow x:Name="FeedbackButton" Title="{loc:Loc HelpFeedback}" Description="{loc:Loc HelpFeedbackDescription}" Trailing="External"
                                            Command="{Binding SendFeedbackCommand}" AutomationProperties.AutomationId="HelpFeedbackButton" />
                    </controls:Stack>
                </controls:Section>
            </controls:Stack>
        </controls:AdaptiveColumns>
    </controls:ScreenPage>
</UserControl>
