<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.CreditsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             AutomationProperties.AutomationId="CreditsPage">
    <!-- docs/spec/screens/credits.md -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" Text="{loc:Loc CreditsTitle}"
                   AutomationProperties.AutomationId="CreditsPageTitle" AutomationProperties.HeadingLevel="Level1" />

        <Border Style="{StaticResource Surface.Card}" Margin="0,24,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="48" Height="48" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{loc:Loc AppName}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}" Text="{Binding VersionText}"
                                   AutomationProperties.AutomationId="CreditsVersion" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{loc:Loc CreditsDescription}" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{loc:Loc CreditsNotAffiliated}"
                           AutomationProperties.AutomationId="CreditsNotAffiliated" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Surface.Card}" Margin="0,16,0,24">
            <StackPanel>
                <StackPanel>
                    <Button x:Name="GitHubButton" HorizontalAlignment="Left" Command="{Binding OpenGitHubCommand}" Content="{loc:Loc CreditsGitHub}"
                            AutomationProperties.AutomationId="CreditsGitHubLink" />
                    <TextBlock Margin="24,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{loc:Loc CreditsGitHubDescription}" />
                </StackPanel>
                <StackPanel Margin="0,16,0,0">
                    <Button x:Name="CreditsListButton" HorizontalAlignment="Left" Command="{Binding OpenCreditsListCommand}" Content="{loc:Loc CreditsList}"
                            AutomationProperties.AutomationId="CreditsListLink" />
                    <TextBlock Margin="24,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{loc:Loc CreditsListDescription}" />
                </StackPanel>
                <StackPanel Margin="0,16,0,0">
                    <Button x:Name="LicenseButton" HorizontalAlignment="Left" Command="{Binding OpenLicenseCommand}" Content="{loc:Loc CreditsLicenseName}"
                            AutomationProperties.AutomationId="CreditsLicenseLink" />
                    <TextBlock Margin="24,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{loc:Loc CreditsLicenseValue}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
