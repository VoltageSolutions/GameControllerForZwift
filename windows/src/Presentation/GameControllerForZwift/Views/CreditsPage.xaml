<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.CreditsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
             AutomationProperties.AutomationId="CreditsPage">
    <!-- docs/spec/screens/credits.md. Two columns on a wide window, one column on a narrow one. -->
    <controls:ScreenPage>
        <controls:AdaptiveColumns SideWidth="{StaticResource Size.SideColumn}">
            <controls:Stack Gap="{DynamicResource Layout.SectionGap}">
                <controls:Stack Gap="{StaticResource Space.8}">
                    <!-- About shows no title text. The wordmark is the level 1 heading, named About (SCR-CRD-009). -->
                    <controls:VoltageWordmark x:Name="PageTitle" Height="{StaticResource Space.40}" HorizontalAlignment="Left"
                                              AutomationProperties.AutomationId="CreditsPageTitle" AutomationProperties.Name="{loc:Loc AboutTitle}"
                                              AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Foreground="{DynamicResource Brush.muted}" Text="{loc:Loc AppName}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}" Text="{Binding VersionText}"
                               AutomationProperties.AutomationId="CreditsVersion" />
                </controls:Stack>
                <TextBlock Style="{StaticResource Text.Body}" Text="{loc:Loc CreditsDescription}" />
                <TextBlock Style="{StaticResource Text.RowCaption}" Text="{loc:Loc CreditsNotAffiliated}"
                           AutomationProperties.AutomationId="CreditsNotAffiliated" />
            </controls:Stack>

            <controls:Stack Gap="{DynamicResource Layout.RowGap}">
                <controls:ActionRow x:Name="GitHubButton" Title="{loc:Loc CreditsGitHub}" Description="{loc:Loc CreditsGitHubDescription}" Trailing="External"
                                    Command="{Binding OpenGitHubCommand}" AutomationProperties.AutomationId="CreditsGitHubLink" />
                <controls:ActionRow x:Name="CreditsListButton" Title="{loc:Loc CreditsList}" Description="{loc:Loc CreditsListDescription}" Trailing="Chevron"
                                    Command="{Binding OpenCreditsListCommand}" AutomationProperties.AutomationId="CreditsListLink" />
                <controls:ActionRow x:Name="LicenseButton" Title="{loc:Loc CreditsLicenseName}" Description="{loc:Loc CreditsLicenseValue}" Trailing="Chevron"
                                    Command="{Binding OpenLicenseCommand}" AutomationProperties.AutomationId="CreditsLicenseLink" />
            </controls:Stack>
        </controls:AdaptiveColumns>
    </controls:ScreenPage>
</UserControl>
