<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             AutomationProperties.AutomationId="ConnectionsPage">
    <!-- docs/spec/screens/connections.md -->
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" Text="{loc:Loc ConnectionsTitle}"
                   AutomationProperties.AutomationId="ConnectionsPageTitle" AutomationProperties.HeadingLevel="Level1" />

        <!-- Zwift card: the status in words, updated live (SCR-CONN-004, SCR-CONN-005). -->
        <Border x:Name="ConnectionsZwiftCard" AutomationProperties.AutomationId="ConnectionsZwiftCard" AutomationProperties.Name="{loc:Loc ConnectionsZwiftCard}" Margin="0,24,0,0" Style="{StaticResource Surface.Row}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="28" Height="28" VerticalAlignment="Center">
                    <!-- Connected: a check in an ok circle. Not connected: an accent-ink dot. The words carry the state. -->
                    <Ellipse x:Name="StatusMark">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Width" Value="12" />
                                <Setter Property="Height" Value="12" />
                                <Setter Property="Fill" Value="{DynamicResource Brush.accent-ink}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Zwift.IsConnected}" Value="True">
                                        <Setter Property="Width" Value="28" />
                                        <Setter Property="Height" Value="28" />
                                        <Setter Property="Fill" Value="{DynamicResource Brush.ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Path x:Name="StatusCheck" Width="16" Height="16" Stretch="None" Data="M3,8.5 L6,11.5 L13,4.5"
                          Stroke="{DynamicResource Brush.surface}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Visibility="{Binding Zwift.IsConnected, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
                <TextBlock x:Name="ZwiftStatusText" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                           Text="{Binding Zwift.StatusText, NotifyOnTargetUpdated=True}"
                           Binding.TargetUpdated="ZwiftStatusText_TargetUpdated"
                           AutomationProperties.AutomationId="ConnectionsZwiftStatus"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
