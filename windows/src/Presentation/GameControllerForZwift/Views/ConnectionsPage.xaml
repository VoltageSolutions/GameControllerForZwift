<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
             AutomationProperties.AutomationId="ConnectionsPage">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="Connections.StepsPanel">
            <controls:Stack Gap="{StaticResource Space.12}" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <!-- docs/spec/screens/connections.md -->
    <controls:ScreenPage>
        <controls:Stack Gap="{DynamicResource Layout.SectionGap}">
            <TextBlock x:Name="PageTitle" Style="{StaticResource Text.PageTitle}" Text="{loc:Loc ConnectionsTitle}"
                       AutomationProperties.AutomationId="ConnectionsPageTitle" AutomationProperties.HeadingLevel="Level1" />

            <controls:Stack Gap="{DynamicResource Layout.CardGap}">
                <!-- Your controller: its name and state in words, a way to pick another, and a way to pair a new one
                     (SCR-CONN-001 to SCR-CONN-003). Both ways out stay visible with no controller. -->
                <Border x:Name="ConnectionsControllerCard" Style="{StaticResource Surface.Card}"
                        AutomationProperties.AutomationId="ConnectionsControllerCard" AutomationProperties.Name="{loc:Loc ConnectionsControllerCard}">
                    <controls:Stack Gap="{DynamicResource Layout.CardGap}">
                        <controls:Stack Gap="{StaticResource Space.4}">
                            <TextBlock Style="{StaticResource Text.RowTitle}" Text="{Binding ControllerText}"
                                       AutomationProperties.AutomationId="ConnectionsControllerName" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ControllerCaption}"
                                       AutomationProperties.AutomationId="ConnectionsControllerState" />
                        </controls:Stack>

                        <controls:Stack Gap="{DynamicResource Layout.LabelGap}">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc ConnectionsPickerLabel}" />
                            <ComboBox x:Name="ControllerPicker" HorizontalAlignment="Left" MinWidth="{StaticResource Size.PickerMinWidth}" MaxWidth="{StaticResource Size.PickerMaxWidth}"
                                      ItemsSource="{Binding Controllers}" SelectedItem="{Binding SelectedController}" DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanPickController}"
                                      AutomationProperties.AutomationId="ConnectionsControllerPicker" AutomationProperties.Name="{loc:Loc ConnectionsPickerLabel}" />
                        </controls:Stack>

                        <controls:Stack Gap="{DynamicResource Layout.LabelGap}">
                            <Button x:Name="PairBluetoothButton" Command="{Binding PairBluetoothCommand}"
                                    Content="{loc:Loc ConnectionsPairBluetooth}"
                                    AutomationProperties.AutomationId="ConnectionsPairBluetoothButton" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc ConnectionsUsbHint}"
                                       AutomationProperties.AutomationId="ConnectionsUsbHint" />
                        </controls:Stack>
                    </controls:Stack>
                </Border>

                <!-- Zwift card: the status in words, updated live (SCR-CONN-004, SCR-CONN-005), then the three steps
                     (SCR-CONN-009). When Zwift is connected the steps collapse behind Show me how (SCR-CONN-011). -->
                <Border x:Name="ConnectionsZwiftCard" Style="{StaticResource Surface.Card}"
                        AutomationProperties.AutomationId="ConnectionsZwiftCard" AutomationProperties.Name="{loc:Loc ConnectionsZwiftCard}">
                    <controls:Stack Gap="{DynamicResource Layout.CardGap}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource Gap.12}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StatusDot x:Name="StatusMark" IsOk="{Binding Zwift.IsConnected, Mode=OneWay}" />
                            <TextBlock x:Name="ZwiftStatusText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.RowTitle}"
                                       Text="{Binding Zwift.StatusText, NotifyOnTargetUpdated=True}"
                                       Binding.TargetUpdated="ZwiftStatusText_TargetUpdated"
                                       AutomationProperties.AutomationId="ConnectionsZwiftStatus"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>

                        <TextBlock x:Name="TrainerReminder" Style="{StaticResource Text.Body}"
                                   Text="{loc:Loc ConnectionsTrainerReminder}"
                                   Visibility="{Binding ShowTrainerReminder, Converter={StaticResource BooleanToVisibility}}"
                                   AutomationProperties.AutomationId="ConnectionsTrainerReminder" />

                        <ItemsControl x:Name="ZwiftSteps" ItemsSource="{Binding Steps}" ItemsPanel="{StaticResource Connections.StepsPanel}" IsTabStop="False"
                                      Visibility="{Binding ShowSteps, Converter={StaticResource BooleanToVisibility}}"
                                      AutomationProperties.AutomationId="ConnectionsSteps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Text}"
                                               AutomationProperties.AutomationId="{Binding AutomationId}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="ShowMeHowButton" Command="{Binding ShowMeHowCommand}"
                                Content="{Binding ShowMeHowLabel}" AutomationProperties.Name="{Binding ShowMeHowLabel}"
                                Visibility="{Binding ShowMeHowVisible, Converter={StaticResource BooleanToVisibility}}"
                                AutomationProperties.AutomationId="ConnectionsShowMeHowButton" />
                    </controls:Stack>
                </Border>
            </controls:Stack>
        </controls:Stack>
    </controls:ScreenPage>
</UserControl>
