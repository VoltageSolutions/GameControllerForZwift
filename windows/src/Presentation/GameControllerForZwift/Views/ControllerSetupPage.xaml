<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.ControllerSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameControllerForZwift.UI.WPF.Views"
             xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
             xmlns:converters="clr-namespace:GameControllerForZwift.UI.WPF.Converters"
             xmlns:vm="clr-namespace:GameControllerForZwift.UI.WPF.ViewModels"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             AutomationProperties.AutomationId="ButtonsPage">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:DoubleToPointConverter x:Key="DoubleToPointConverter" />

        <DataTemplate x:Key="Buttons.RowTemplate" DataType="{x:Type vm:ButtonRowViewModel}">
            <Button Style="{StaticResource Buttons.RowStyle}"
                    Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.Name="{Binding AccessibleName}" />
        </DataTemplate>

        <!-- Rows go in as many columns as fit, one column on a phone (UX-V-049). -->
        <ItemsPanelTemplate x:Key="Buttons.RowsPanel">
            <controls:ColumnGrid MinColumnWidth="{StaticResource Size.RowMinWidth}" Gap="{DynamicResource Layout.RowGap}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="Buttons.GroupsPanel">
            <controls:Stack Gap="{DynamicResource Layout.SectionGap}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="Buttons.ItemsPanel">
            <controls:Stack Gap="{StaticResource Space.4}" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid x:Name="PageRoot">
        <controls:ScreenPage>
            <controls:Stack x:Name="PageContent" Gap="{DynamicResource Layout.SectionGap}">
                <TextBlock x:Name="PageTitle" Style="{StaticResource Text.PageTitle}" Text="{loc:Loc ButtonsTitle}"
                           AutomationProperties.AutomationId="ButtonsPageTitle" AutomationProperties.HeadingLevel="Level1" />

                <!-- No controller state -->
                <Border x:Name="NoControllerCard" Style="{StaticResource Surface.Card}"
                        Visibility="{Binding SelectedController, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                        AutomationProperties.AutomationId="ButtonsNoControllerCard">
                    <controls:Stack Gap="{StaticResource Space.4}">
                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="{loc:Loc ButtonsNoController}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc ButtonsLooking}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </controls:Stack>
                </Border>

                <controls:Stack x:Name="ControllerContent" Gap="{DynamicResource Layout.CardGap}"
                                Visibility="{Binding SelectedController, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock x:Name="ControllerNameText" Style="{StaticResource Text.Caption}" Text="{Binding ControllerName}"
                               AutomationProperties.AutomationId="ButtonsControllerName" />

                    <!-- Configuration toolbar -->
                    <controls:Stack Orientation="Horizontal" Wrap="True" Gap="{DynamicResource Layout.ButtonGap}">
                        <ComboBox x:Name="ConfigurationComboBox" Width="{StaticResource Size.PickerMaxWidth}"
                                  ItemsSource="{Binding Configurations}" SelectedItem="{Binding SelectedConfiguration}"
                                  SelectionChanged="SelectionComboBox_SelectionChanged"
                                  AutomationProperties.AutomationId="ButtonsMappingPicker" AutomationProperties.Name="{loc:Loc ButtonsMappingPicker}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConfigurationItem}">
                                    <controls:Stack Orientation="Horizontal" Gap="{StaticResource Space.12}">
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.RowTitle}" Text="{Binding ListName}" />
                                        <controls:Stack Orientation="Horizontal" Gap="{StaticResource Space.8}" VerticalAlignment="Center"
                                                        Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibility}}">
                                            <Ellipse Width="{StaticResource Size.StatusDot}" Height="{StaticResource Size.StatusDot}" Fill="{DynamicResource Brush.accent}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Text.Mark}" Text="{loc:Loc ButtonsUnsaved}" />
                                        </controls:Stack>
                                    </controls:Stack>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="SaveConfigurationButton" Style="{StaticResource Buttons.SaveStyle}"
                                Command="{Binding SaveCommand}" Content="{loc:Loc ButtonsSave}"
                                AutomationProperties.AutomationId="ButtonsSaveButton" />
                        <Button x:Name="SaveConfigurationAsButton" Command="{Binding SaveAsCommand}" Content="{loc:Loc ButtonsSaveAs}"
                                AutomationProperties.AutomationId="ButtonsSaveAsButton" />
                        <Button x:Name="DeleteConfigurationButton" Command="{Binding DeleteCommand}" Content="{loc:Loc ButtonsDelete}"
                                AutomationProperties.AutomationId="ButtonsDeleteButton" />
                        <Button x:Name="MoreConfigurationActionsButton" Style="{StaticResource Button.Icon}"
                                Click="MoreConfigurationActionsButton_Click"
                                AutomationProperties.AutomationId="ButtonsMoreButton" AutomationProperties.Name="{loc:Loc ButtonsMore}">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFill.More}" StrokeThickness="0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MoreConfigurationActionsMenu" AutomationProperties.AutomationId="ButtonsMoreMenu"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{loc:Loc ButtonsMenuImport}" Command="{Binding ImportCommand}" AutomationProperties.AutomationId="ImportConfigurationMenuItem" />
                                    <MenuItem Header="{loc:Loc ButtonsMenuRename}" Command="{Binding RenameCommand}" AutomationProperties.AutomationId="RenameConfigurationMenuItem" />
                                    <MenuItem Header="{loc:Loc ButtonsMenuOpenFolder}" Command="{Binding OpenFolderCommand}" AutomationProperties.AutomationId="OpenConfigurationFolderMenuItem" />
                                    <MenuItem Header="{loc:Loc ButtonsMenuReset}" Command="{Binding ResetToDefaultCommand}" AutomationProperties.AutomationId="ResetToDefaultMenuItem" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </controls:Stack>

                    <CheckBox x:Name="ShowOtherControllersConfigurationsCheckBox" HorizontalAlignment="Left"
                              Content="{loc:Loc ButtonsShowOthers}" ToolTip="{loc:Loc ButtonsShowOthersTip}"
                              IsChecked="{Binding ShowOtherControllersConfigurations}"
                              AutomationProperties.AutomationId="ButtonsShowOthersToggle" />

                    <!-- Notice -->
                    <Border x:Name="ConfigurationNotice" Style="{StaticResource Surface.Row}" HorizontalAlignment="Left"
                            Visibility="{Binding NoticeText, Converter={StaticResource NullToVisibilityConverter}}"
                            AutomationProperties.AutomationId="ButtonsNotice">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource Gap.12}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource Gap.12}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:StatusDot IsOk="True" AutomationProperties.Name="{loc:Loc ButtonsNoticeIcon}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding NoticeText}"
                                       AutomationProperties.AutomationId="ButtonsNoticeStatus" AutomationProperties.LiveSetting="Polite" />
                            <Button Grid.Column="4" Style="{StaticResource Button.Icon}" Command="{Binding DismissNoticeCommand}"
                                    AutomationProperties.AutomationId="ButtonsNoticeDismissButton" AutomationProperties.Name="{loc:Loc ButtonsNoticeDismiss}">
                                <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Close}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tabs: a segmented track that fits the page width (UX-V-048, UX-V-044). -->
                    <Border Style="{StaticResource Segmented.Track}" AutomationProperties.Name="{loc:Loc ButtonsTabs}">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="ButtonsTabButton" GroupName="ButtonsTabs" Style="{StaticResource Buttons.TabStyle}"
                                         IsChecked="{Binding IsButtonsTabSelected}" Content="{loc:Loc ButtonsTabButtons}"
                                         AutomationProperties.AutomationId="ButtonsButtonsTab" />
                            <RadioButton x:Name="SticksTabButton" GroupName="ButtonsTabs" Style="{StaticResource Buttons.TabStyle}"
                                         IsChecked="{Binding IsSticksTabSelected}" Content="{loc:Loc ButtonsTabSticks}"
                                         AutomationProperties.AutomationId="ButtonsSticksTab" />
                        </UniformGrid>
                    </Border>

                    <!-- Responsive workspace: 2 columns in landscape, stacked when narrow -->
                    <Grid x:Name="WorkspaceGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ControllerColumn" Width="Auto" />
                            <ColumnDefinition x:Name="DetailsColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ControllerRow" Height="Auto" />
                            <RowDefinition x:Name="DetailsRow" Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Left (or top when narrow): Live SVG controller preview -->
                        <Border x:Name="ControllerVisualCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource Surface.Card}" VerticalAlignment="Top">
                            <controls:Stack Gap="{StaticResource Space.12}">
                                <controls:ControllerDiagramView x:Name="ControllerDiagram"
                                    AutomationProperties.AutomationId="ButtonsControllerImage"
                                    Width="{StaticResource Size.DiagramWidth}" Height="{StaticResource Size.DiagramHeight}"
                                    HorizontalAlignment="Center"
                                    SelectedInput="{Binding SelectedRow.Input}"
                                    Rows="{Binding Rows}"
                                    ControllerValues="{Binding CurrentControllerValues}" />

                                <!-- Selected row title & hint underneath the diagram (no pill) -->
                                <controls:Stack Gap="{StaticResource Space.8}" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedRow.FunctionTitle}" HorizontalAlignment="Center" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.RowTitle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="HintText" Style="{StaticResource Text.Caption}" TextAlignment="Center"
                                               Text="{loc:Loc ButtonsHint}" AutomationProperties.AutomationId="ButtonsHintStatus" />
                                </controls:Stack>
                            </controls:Stack>
                        </Border>

                        <!-- Right (or bottom when narrow): Buttons tab or Sticks and triggers tab -->
                        <Grid x:Name="DetailsHost" Grid.Column="1" Grid.Row="0">
                            <!-- Buttons tab -->
                            <ItemsControl x:Name="ButtonsList" ItemsSource="{Binding ButtonRows}" ItemTemplate="{StaticResource Buttons.RowTemplate}"
                                          ItemsPanel="{StaticResource Buttons.RowsPanel}" IsTabStop="False"
                                          Visibility="{Binding IsButtonsTabSelected, Converter={StaticResource BooleanToVisibility}}"
                                          AutomationProperties.AutomationId="ButtonsList" AutomationProperties.Name="{loc:Loc ButtonsListName}" />

                            <!-- Sticks and triggers tab -->
                            <controls:ColumnGrid x:Name="SticksContent" MinColumnWidth="{StaticResource Size.CardMinWidth}" Gap="{DynamicResource Layout.CardGap}"
                                       Visibility="{Binding IsSticksTabSelected, Converter={StaticResource BooleanToVisibility}}"
                                       AutomationProperties.AutomationId="ButtonsSticksList" AutomationProperties.Name="{loc:Loc ButtonsSticksListName}">
                                <Border Style="{StaticResource Surface.Card}" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="ButtonsLeftStickCard">
                                    <controls:Stack Gap="{DynamicResource Layout.CardGap}">
                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="{loc:Loc ButtonsLeftStick}" AutomationProperties.HeadingLevel="Level2" />
                                        <controls:ThumbstickGraph x:Name="LeftStickGraph" Width="{StaticResource Size.GraphSize}" Height="{StaticResource Size.GraphSize}" HorizontalAlignment="Left"
                                                                  MinX="-32768" MaxX="32767" MinY="-32768" MaxY="32676"
                                                                  AutomationProperties.AutomationId="ButtonsLeftStickImage" AutomationProperties.Name="{loc:Loc ButtonsStickPosition}">
                                            <controls:ThumbstickGraph.Position>
                                                <MultiBinding Converter="{StaticResource DoubleToPointConverter}">
                                                    <Binding Path="CurrentControllerValues.LeftThumbstickX" />
                                                    <Binding Path="CurrentControllerValues.LeftThumbstickY" />
                                                </MultiBinding>
                                            </controls:ThumbstickGraph.Position>
                                        </controls:ThumbstickGraph>
                                        <ItemsControl ItemsSource="{Binding LeftStickRows}" ItemTemplate="{StaticResource Buttons.RowTemplate}"
                                                      ItemsPanel="{StaticResource Buttons.RowsPanel}" IsTabStop="False" />
                                    </controls:Stack>
                                </Border>
                                <Border Style="{StaticResource Surface.Card}" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="ButtonsRightStickCard">
                                    <controls:Stack Gap="{DynamicResource Layout.CardGap}">
                                        <TextBlock Style="{StaticResource Text.RowTitle}" Text="{loc:Loc ButtonsRightStick}" AutomationProperties.HeadingLevel="Level2" />
                                        <controls:ThumbstickGraph x:Name="RightStickGraph" Width="{StaticResource Size.GraphSize}" Height="{StaticResource Size.GraphSize}" HorizontalAlignment="Left"
                                                                  MinX="-32768" MaxX="32767" MinY="-32768" MaxY="32676"
                                                                  AutomationProperties.AutomationId="ButtonsRightStickImage" AutomationProperties.Name="{loc:Loc ButtonsStickPosition}">
                                            <controls:ThumbstickGraph.Position>
                                                <MultiBinding Converter="{StaticResource DoubleToPointConverter}">
                                                    <Binding Path="CurrentControllerValues.RightThumbstickX" />
                                                    <Binding Path="CurrentControllerValues.RightThumbstickY" />
                                                </MultiBinding>
                                            </controls:ThumbstickGraph.Position>
                                        </controls:ThumbstickGraph>
                                        <ItemsControl ItemsSource="{Binding RightStickRows}" ItemTemplate="{StaticResource Buttons.RowTemplate}"
                                                      ItemsPanel="{StaticResource Buttons.RowsPanel}" IsTabStop="False" />
                                    </controls:Stack>
                                </Border>
                                <Border Style="{StaticResource Surface.Card}" VerticalAlignment="Top"
                                        AutomationProperties.AutomationId="ButtonsTriggersCard">
                                    <controls:Stack Gap="{DynamicResource Layout.CardGap}">
                                        <controls:Stack Gap="{StaticResource Space.4}">
                                            <TextBlock Style="{StaticResource Text.RowTitle}" Text="{loc:Loc ButtonsTriggers}" AutomationProperties.HeadingLevel="Level2" />
                                            <TextBlock x:Name="BrakeCaution" Style="{StaticResource Text.Caption}" Text="{loc:Loc ButtonsBrakeCaution}"
                                                       AutomationProperties.AutomationId="ButtonsBrakeCautionStatus" />
                                        </controls:Stack>
                                        <ContentControl Content="{Binding TriggerRows[0]}" ContentTemplate="{StaticResource Buttons.RowTemplate}" IsTabStop="False" />
                                        <controls:GaugeControl x:Name="LeftTriggerGauge" MaxValue="32767" Value="{Binding CurrentControllerValues.LeftTrigger}"
                                                               AutomationProperties.AutomationId="ButtonsLeftTriggerImage" AutomationProperties.Name="{loc:Loc ButtonsTriggerFill}" />
                                        <ContentControl Content="{Binding TriggerRows[1]}" ContentTemplate="{StaticResource Buttons.RowTemplate}" IsTabStop="False" />
                                        <controls:GaugeControl x:Name="RightTriggerGauge" MaxValue="32767" Value="{Binding CurrentControllerValues.RightTrigger}"
                                                               AutomationProperties.AutomationId="ButtonsRightTriggerImage" AutomationProperties.Name="{loc:Loc ButtonsTriggerFill}" />
                                    </controls:Stack>
                                </Border>
                            </controls:ColumnGrid>
                        </Grid>
                    </Grid>
                </controls:Stack>
            </controls:Stack>
        </controls:ScreenPage>

        <!-- Function picker sheet. While it is open the page hands it to the window, so it covers the navigation and the
             More button (UX-N-013). -->
        <Grid x:Name="FunctionOverlay" Visibility="{Binding FunctionPicker.IsOpen, Converter={StaticResource BooleanToVisibility}}">
            <Border x:Name="FunctionScrim" Background="{DynamicResource Brush.scrim}" MouseLeftButtonDown="FunctionScrim_MouseLeftButtonDown" />
            <Border x:Name="FunctionPanel" Style="{StaticResource Sheet.Panel}" MaxWidth="{Binding ActualWidth, ElementName=FunctionOverlay}"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                    PreviewKeyDown="FunctionPanel_PreviewKeyDown"
                    AutomationProperties.AutomationId="ButtonsFunctionPanel" AutomationProperties.Name="{Binding FunctionPicker.Title}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="{StaticResource Inset.SheetHeader}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{StaticResource Gap.12}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource Gap.12}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Chip.Key}" Background="{DynamicResource Brush.accent}">
                            <TextBlock Style="{StaticResource Text.Chip}" Foreground="{DynamicResource Brush.on-accent}" Text="{Binding FunctionPicker.Target.Chip}" />
                        </Border>
                        <TextBlock x:Name="FunctionPanelTitle" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Title}"
                                   Text="{Binding FunctionPicker.Title}" AutomationProperties.HeadingLevel="Level2" />
                        <Button x:Name="FunctionPanelCloseButton" Grid.Column="4" Style="{StaticResource Button.Icon}" Command="{Binding FunctionPicker.CloseCommand}"
                                AutomationProperties.AutomationId="ButtonsFunctionCloseButton" AutomationProperties.Name="{loc:Loc ButtonsPickerClose}">
                            <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Close}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding FunctionPicker.Groups}" ItemsPanel="{StaticResource Buttons.GroupsPanel}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FunctionGroupViewModel}">
                                    <controls:Section Label="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                        <ItemsControl ItemsSource="{Binding Items}" ItemsPanel="{StaticResource Buttons.ItemsPanel}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FunctionItemViewModel}">
                                                    <RadioButton GroupName="ButtonsFunctions" Style="{StaticResource Buttons.FunctionStyle}"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="FunctionItem_Checked"
                                                                 AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                 AutomationProperties.Name="{Binding AccessibleName}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </controls:Section>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
