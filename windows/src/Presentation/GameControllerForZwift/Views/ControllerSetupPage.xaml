<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.ControllerSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameControllerForZwift.UI.WPF.Views"
             xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
             xmlns:converters="clr-namespace:GameControllerForZwift.UI.WPF.Converters"
             xmlns:vm="clr-namespace:GameControllerForZwift.UI.WPF.ViewModels"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             AutomationProperties.AutomationId="ButtonsPage">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:PullFillConverter x:Key="PullFill" />

        <!-- A row: the input's chip, what it does, a Changed mark, and a chevron (SCR-BTN-003). -->
        <Style x:Key="Buttons.RowStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Fill" CornerRadius="18" Background="{DynamicResource Brush.surface}" Effect="{DynamicResource Effect.shadow}" />
                            <Border x:Name="Tint" CornerRadius="18" Background="{DynamicResource Brush.accent}" Opacity="0.22" Visibility="Collapsed" />
                            <Border x:Name="FreeOutline" CornerRadius="18" BorderThickness="2" BorderBrush="{DynamicResource Brush.surface-2}" Visibility="Collapsed" />
                            <Border x:Name="Film" CornerRadius="18" Background="{DynamicResource Brush.text}" Opacity="0" />
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- The chip. A trigger's chip also fills with the accent from left to right as the trigger is pulled: a full accent pill, clipped so a straight edge moves across (SCR-BTN-041). -->
                                <Grid x:Name="ChipHost" MinWidth="44" Height="30" VerticalAlignment="Center">
                                    <Border x:Name="Chip" CornerRadius="15" Background="{DynamicResource Brush.surface-2}" />
                                    <Border x:Name="PullFill" CornerRadius="15" Background="{DynamicResource Brush.accent}" Visibility="Collapsed">
                                        <Border.Clip>
                                            <MultiBinding Converter="{StaticResource PullFill}">
                                                <Binding Path="PullRatio" />
                                                <Binding Path="ActualWidth" ElementName="ChipHost" />
                                            </MultiBinding>
                                        </Border.Clip>
                                    </Border>
                                    <TextBlock x:Name="ChipText" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{DynamicResource Font.Figtree}"
                                               FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Brush.text}" Text="{Binding Chip}" />
                                    <TextBlock x:Name="ChipTextOnFill" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{DynamicResource Font.Figtree}"
                                               FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Brush.on-accent}" Text="{Binding Chip}" Visibility="Collapsed">
                                        <TextBlock.Clip>
                                            <MultiBinding Converter="{StaticResource PullFill}">
                                                <Binding Path="PullRatio" />
                                                <Binding Path="ActualWidth" ElementName="ChipHost" />
                                            </MultiBinding>
                                        </TextBlock.Clip>
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="FunctionText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           FontFamily="{DynamicResource Font.Figtree}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.text}"
                                           Text="{Binding FunctionTitle}" />
                                <StackPanel x:Name="ChangedMark" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                            Visibility="{Binding IsChanged, Converter={StaticResource BooleanToVisibility}}">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.accent}" VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Figtree}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.accent-ink}" Text="{loc:Loc ButtonsChanged}" />
                                </StackPanel>
                                <Path Grid.Column="3" VerticalAlignment="Center" Width="24" Height="24" Stretch="None" Data="M9,6 L15,12 L9,18"
                                      Stroke="{DynamicResource Brush.text}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Film" Property="Opacity" Value="0.06" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Film" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsFree}" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="Transparent" />
                                <Setter TargetName="Fill" Property="Effect" Value="{x:Null}" />
                                <Setter TargetName="FreeOutline" Property="Visibility" Value="Visible" />
                                <Setter TargetName="FunctionText" Property="Foreground" Value="{DynamicResource Brush.muted}" />
                                <Setter TargetName="FunctionText" Property="FontWeight" Value="Medium" />
                                <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.muted}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tint" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.accent}" />
                                <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.on-accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAnalogTrigger}" Value="True">
                                <Setter TargetName="PullFill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ChipTextOnFill" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed}" Value="True" />
                                    <Condition Binding="{Binding IsAnalogTrigger}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.accent}" />
                                <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.on-accent}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Buttons.RowTemplate" DataType="{x:Type vm:ButtonRowViewModel}">
            <Button Style="{StaticResource Buttons.RowStyle}" Margin="0,0,12,12"
                    Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.Name="{Binding AccessibleName}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Buttons.RowsPanel">
            <WrapPanel ItemWidth="{Binding RowWidth, RelativeSource={RelativeSource AncestorType=local:ControllerSetupPage}}" />
        </ItemsPanelTemplate>

        <Style x:Key="Buttons.SaveStyle" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.on-accent}" />
                    <Setter Property="FontWeight" Value="ExtraBold" />
                    <Setter Property="MinWidth" Value="160" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Buttons.TabStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Figtree}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.muted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Fill" CornerRadius="24" Background="Transparent" />
                            <ContentPresenter Margin="20,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.surface}" />
                                <Setter TargetName="Fill" Property="Effect" Value="{DynamicResource Effect.shadow}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Buttons.FunctionStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Tint" CornerRadius="14" Background="{DynamicResource Brush.accent}" Opacity="0.22" Visibility="Collapsed" />
                            <Border x:Name="Film" CornerRadius="14" Background="{DynamicResource Brush.text}" Opacity="0" />
                            <Grid Margin="12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" FontFamily="{DynamicResource Font.Figtree}" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.text}" Text="{Binding Title}" />
                                    <TextBlock TextWrapping="Wrap" FontFamily="{DynamicResource Font.Figtree}" FontSize="14"
                                               Foreground="{DynamicResource Brush.muted}" Text="{Binding Hint}" />
                                </StackPanel>
                                <Grid x:Name="CheckBadge" Grid.Column="1" Width="24" Height="24" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Ellipse Fill="{DynamicResource Brush.text}" />
                                    <Path Width="24" Height="24" Stretch="None" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.bg}"
                                          StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Film" Property="Opacity" Value="0.06" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tint" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="PageContent" Margin="0,0,0,24" HorizontalAlignment="Stretch">
                <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" Text="{loc:Loc ButtonsTitle}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ButtonsPageTitle" AutomationProperties.HeadingLevel="Level1" />

                <!-- No controller state -->
                <Border x:Name="NoControllerCard" Style="{StaticResource Surface.Card}" Margin="0,24,0,0"
                        Visibility="{Binding SelectedController, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                        AutomationProperties.AutomationId="ButtonsNoControllerCard">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" Text="{loc:Loc ButtonsNoController}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{loc:Loc ButtonsLooking}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ControllerContent"
                            Visibility="{Binding SelectedController, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock x:Name="ControllerNameText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding ControllerName}"
                               AutomationProperties.AutomationId="ButtonsControllerName" />

                    <!-- Configuration toolbar -->
                    <WrapPanel Margin="0,20,0,0">
                        <ComboBox x:Name="ConfigurationComboBox" Width="420" Margin="0,0,12,12"
                                  ItemsSource="{Binding Configurations}" SelectedItem="{Binding SelectedConfiguration}"
                                  SelectionChanged="SelectionComboBox_SelectionChanged"
                                  AutomationProperties.AutomationId="ButtonsMappingPicker" AutomationProperties.Name="{loc:Loc ButtonsMappingPicker}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConfigurationItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding ListName}" />
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibility}}">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.accent}" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.accent-ink}"
                                                       Text="{loc:Loc ButtonsUnsaved}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="SaveConfigurationButton" Style="{StaticResource Buttons.SaveStyle}" Margin="0,0,12,12"
                                Command="{Binding SaveCommand}" Content="{loc:Loc ButtonsSave}"
                                AutomationProperties.AutomationId="ButtonsSaveButton" />
                        <Button x:Name="SaveConfigurationAsButton" Margin="0,0,12,12" Command="{Binding SaveAsCommand}" Content="{loc:Loc ButtonsSaveAs}"
                                AutomationProperties.AutomationId="ButtonsSaveAsButton" />
                        <Button x:Name="DeleteConfigurationButton" Margin="0,0,12,12" Command="{Binding DeleteCommand}" Content="{loc:Loc ButtonsDelete}"
                                AutomationProperties.AutomationId="ButtonsDeleteButton" />
                        <Button x:Name="MoreConfigurationActionsButton" Style="{StaticResource Button.Icon}" Margin="0,0,12,12"
                                Click="MoreConfigurationActionsButton_Click"
                                AutomationProperties.AutomationId="ButtonsMoreButton" AutomationProperties.Name="{loc:Loc ButtonsMore}">
                            <Path Width="24" Height="24" Stretch="None" Data="{StaticResource IconFill.More}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MoreConfigurationActionsMenu" AutomationProperties.AutomationId="ButtonsMoreMenu"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{loc:Loc ButtonsMenuImport}" Command="{Binding ImportCommand}" AutomationProperties.AutomationId="ImportConfigurationMenuItem" />
                                    <MenuItem Header="{loc:Loc ButtonsMenuRename}" Command="{Binding RenameCommand}" AutomationProperties.AutomationId="RenameConfigurationMenuItem" />
                                    <MenuItem Header="{loc:Loc ButtonsMenuOpenFolder}" Command="{Binding OpenFolderCommand}" AutomationProperties.AutomationId="OpenConfigurationFolderMenuItem" />
                                    <MenuItem Header="{loc:Loc ButtonsMenuReset}" Command="{Binding ResetToDefaultCommand}" AutomationProperties.AutomationId="ResetToDefaultMenuItem" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>

                    <CheckBox x:Name="ShowOtherControllersConfigurationsCheckBox" Margin="0,0,0,12" HorizontalAlignment="Left"
                              Content="{loc:Loc ButtonsShowOthers}" ToolTip="{loc:Loc ButtonsShowOthersTip}"
                              IsChecked="{Binding ShowOtherControllersConfigurations}"
                              AutomationProperties.AutomationId="ButtonsShowOthersToggle" />

                    <!-- Notice -->
                    <Border x:Name="ConfigurationNotice" Style="{StaticResource Surface.Row}" Margin="0,0,0,12" HorizontalAlignment="Left" MinWidth="300"
                            Visibility="{Binding NoticeText, Converter={StaticResource NullToVisibilityConverter}}"
                            AutomationProperties.AutomationId="ButtonsNotice">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Margin="0,0,10,0" VerticalAlignment="Center" Width="24" Height="24" Stretch="None" Data="{StaticResource Icon.Check}"
                                  Stroke="{DynamicResource Brush.ok}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  AutomationProperties.Name="{loc:Loc ButtonsNoticeIcon}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding NoticeText}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ButtonsNoticeStatus" AutomationProperties.LiveSetting="Polite" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Margin="12,0,0,0" Command="{Binding DismissNoticeCommand}"
                                    AutomationProperties.AutomationId="ButtonsNoticeDismissButton" AutomationProperties.Name="{loc:Loc ButtonsNoticeDismiss}">
                                <Path Width="24" Height="24" Stretch="None" Data="{StaticResource Icon.Close}" Style="{StaticResource IconStroke}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tabs -->
                    <Border CornerRadius="28" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,20" Background="{DynamicResource Brush.surface-2}"
                            AutomationProperties.Name="{loc:Loc ButtonsTabs}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ButtonsTabButton" GroupName="ButtonsTabs" Style="{StaticResource Buttons.TabStyle}"
                                         IsChecked="{Binding IsButtonsTabSelected}" Content="{loc:Loc ButtonsTabButtons}"
                                         AutomationProperties.AutomationId="ButtonsButtonsTab" />
                            <RadioButton x:Name="SticksTabButton" GroupName="ButtonsTabs" Style="{StaticResource Buttons.TabStyle}"
                                         IsChecked="{Binding IsSticksTabSelected}" Content="{loc:Loc ButtonsTabSticks}"
                                         AutomationProperties.AutomationId="ButtonsSticksTab" />
                        </StackPanel>
                    </Border>

                    <!-- Responsive workspace: 2 columns in landscape, stacked when narrow -->
                    <Grid x:Name="WorkspaceGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ControllerColumn" Width="Auto" />
                            <ColumnDefinition x:Name="DetailsColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ControllerRow" Height="Auto" />
                            <RowDefinition x:Name="DetailsRow" Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Left (or top when narrow): Live SVG controller preview -->
                        <Border x:Name="ControllerVisualCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource Surface.Card}"
                                Margin="0,0,29,16" Padding="16" VerticalAlignment="Top">
                            <StackPanel>
                                <controls:ControllerDiagramView x:Name="ControllerDiagram"
                                    AutomationProperties.AutomationId="ButtonsControllerImage"
                                    Width="296" Height="249"
                                    HorizontalAlignment="Center"
                                    SelectedInput="{Binding SelectedRow.Input}"
                                    Kind="{Binding ControllerKind}"
                                    Rows="{Binding Rows}"
                                    ControllerValues="{Binding CurrentControllerValues}" />

                                <!-- Selected row title & hint underneath the diagram (no pill) -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding SelectedRow.FunctionTitle}" HorizontalAlignment="Center" TextAlignment="Center"
                                               FontFamily="{DynamicResource Font.Figtree}" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="HintText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center"
                                               Margin="0,6,0,0" Text="{loc:Loc ButtonsHint}" AutomationProperties.AutomationId="ButtonsHintStatus" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right (or bottom when narrow): Buttons tab or Sticks and triggers tab -->
                        <Grid x:Name="DetailsHost" Grid.Column="1" Grid.Row="0">
                            <!-- Buttons tab -->
                            <ItemsControl x:Name="ButtonsList" ItemsSource="{Binding ButtonRows}" ItemTemplate="{StaticResource Buttons.RowTemplate}"
                                          ItemsPanel="{StaticResource Buttons.RowsPanel}" IsTabStop="False"
                                          Visibility="{Binding IsButtonsTabSelected, Converter={StaticResource BooleanToVisibility}}"
                                          AutomationProperties.AutomationId="ButtonsList" AutomationProperties.Name="{loc:Loc ButtonsListName}" />

                            <!-- Sticks and triggers tab: the same rows and columns as the Buttons tab, a trigger's chip filling as it is pulled -->
                            <ItemsControl x:Name="SticksContent" ItemsSource="{Binding SticksAndTriggersRows}" ItemTemplate="{StaticResource Buttons.RowTemplate}"
                                          ItemsPanel="{StaticResource Buttons.RowsPanel}" IsTabStop="False"
                                          Visibility="{Binding IsSticksTabSelected, Converter={StaticResource BooleanToVisibility}}"
                                          AutomationProperties.AutomationId="ButtonsSticksList" AutomationProperties.Name="{loc:Loc ButtonsSticksListName}" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Function picker overlay -->
        <Grid x:Name="FunctionOverlay" Visibility="{Binding FunctionPicker.IsOpen, Converter={StaticResource BooleanToVisibility}}">
            <Border x:Name="FunctionScrim" Background="{DynamicResource Brush.scrim}" MouseLeftButtonDown="FunctionScrim_MouseLeftButtonDown" />
            <Border x:Name="FunctionPanel" HorizontalAlignment="Right" Width="440" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="{DynamicResource Brush.surface}" CornerRadius="32,0,0,32" Padding="16,24"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                    PreviewKeyDown="FunctionPanel_PreviewKeyDown"
                    AutomationProperties.AutomationId="ButtonsFunctionPanel" AutomationProperties.Name="{Binding FunctionPicker.Title}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border MinWidth="44" Height="30" CornerRadius="15" VerticalAlignment="Center" Background="{DynamicResource Brush.accent}">
                            <TextBlock Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{DynamicResource Font.Figtree}" FontSize="15"
                                       FontWeight="ExtraBold" Foreground="{DynamicResource Brush.on-accent}" Text="{Binding FunctionPicker.Target.Chip}" />
                        </Border>
                        <TextBlock x:Name="FunctionPanelTitle" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Text.Title}" FontSize="24"
                                   TextWrapping="Wrap" Text="{Binding FunctionPicker.Title}" AutomationProperties.HeadingLevel="Level2" />
                        <Button x:Name="FunctionPanelCloseButton" Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding FunctionPicker.CloseCommand}"
                                AutomationProperties.AutomationId="ButtonsFunctionCloseButton" AutomationProperties.Name="{loc:Loc ButtonsPickerClose}">
                            <Path Width="24" Height="24" Stretch="None" Data="{StaticResource Icon.Close}" Style="{StaticResource IconStroke}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding FunctionPicker.Groups}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FunctionGroupViewModel}">
                                    <StackPanel Margin="0,8,0,0" AutomationProperties.Name="{Binding Title}">
                                        <TextBlock Margin="12,8,12,2" FontFamily="{DynamicResource Font.Figtree}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.muted}" TextWrapping="Wrap" Text="{Binding Title}"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                        <ItemsControl ItemsSource="{Binding Items}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FunctionItemViewModel}">
                                                    <RadioButton GroupName="ButtonsFunctions" Style="{StaticResource Buttons.FunctionStyle}"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="FunctionItem_Checked"
                                                                 AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                 AutomationProperties.Name="{Binding AccessibleName}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>