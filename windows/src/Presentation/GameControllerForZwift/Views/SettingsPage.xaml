<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             xmlns:vm="clr-namespace:GameControllerForZwift.UI.WPF.ViewModels"
             xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
             AutomationProperties.AutomationId="SettingsPage">
    <!-- docs/spec/screens/settings.md. Two columns on a wide window: the title and what the screen is for on the left, every
         row on the right (UX-V-049). One column on a narrow one. -->
    <controls:ScreenPage>
        <controls:AdaptiveColumns SideWidth="{StaticResource Size.SideColumn}">
            <controls:Stack Gap="{DynamicResource Layout.SectionGap}">
                <TextBlock x:Name="PageTitle" Style="{StaticResource Text.PageTitle}" Text="{loc:Loc SettingsTitle}"
                           AutomationProperties.AutomationId="SettingsPageTitle" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock MaxWidth="{StaticResource Size.SideColumn}" HorizontalAlignment="Left" Style="{StaticResource Text.Lead}" Text="{loc:Loc SettingsIntro}" />
            </controls:Stack>

            <controls:Stack Gap="{DynamicResource Layout.SectionGap}">
                <!-- Appearance (SCR-SET-001) -->
                <controls:Section Label="{loc:Loc SettingsAppearanceSection}">
                    <ListBox x:Name="AppearancePicker" Style="{StaticResource Segmented}"
                             ItemsSource="{x:Static vm:SettingsViewModel.AppearanceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                             SelectedValue="{Binding Appearance}"
                             AutomationProperties.AutomationId="SettingsAppearanceGroup" AutomationProperties.Name="{loc:Loc SettingsAppearanceSection}" />
                </controls:Section>

                <!-- Rides: the ride timeout (SCR-SET-012, SCR-SET-013). On a narrow window the box moves under the words
                     (UX-V-030). -->
                <controls:Section Label="{loc:Loc SettingsRidesSection}">
                    <controls:Stack Gap="{StaticResource Space.8}">
                        <Border Style="{StaticResource Surface.Row}">
                            <controls:Stack Orientation="Horizontal" Wrap="True" Gap="{StaticResource Space.16}">
                                <controls:Stack Gap="{StaticResource Space.4}" MaxWidth="{StaticResource Size.RowTextWidth}" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.RowTitle}" Text="{loc:Loc SettingsRideTimeout}" />
                                    <TextBlock Style="{StaticResource Text.RowCaption}" Text="{loc:Loc SettingsRideTimeoutDescription}" />
                                </controls:Stack>
                                <TextBox x:Name="RideTimeoutBox" VerticalAlignment="Center" Width="{StaticResource Size.NumberBoxWidth}"
                                         Text="{Binding RideTimeoutText, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.AutomationId="SettingsRideTimeoutInput" AutomationProperties.Name="{loc:Loc SettingsRideTimeout}" />
                            </controls:Stack>
                        </Border>
                        <TextBlock x:Name="RideTimeoutMessage" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.accent-ink}" Text="{Binding RideTimeoutMessage}"
                                   Visibility="{Binding HasRideTimeoutMessage, Converter={StaticResource BooleanToVisibility}}"
                                   AutomationProperties.AutomationId="SettingsRideTimeoutMessage" AutomationProperties.LiveSetting="Polite" />
                    </controls:Stack>
                </controls:Section>

                <!-- Mappings (SCR-SET-003 to SCR-SET-005) -->
                <controls:Section Label="{loc:Loc SettingsMappingsSection}">
                    <controls:Stack Gap="{DynamicResource Layout.RowGap}">
                        <controls:ActionRow x:Name="OpenMappingsButton" Title="{loc:Loc SettingsOpenMappings}" Trailing="External"
                                            Command="{Binding OpenMappingsFolderCommand}" AutomationProperties.AutomationId="SettingsOpenMappingsButton" />
                        <controls:ActionRow x:Name="DeleteAllButton" Style="{StaticResource ActionRow.Danger}"
                                            Title="{loc:Loc SettingsDeleteAll}" Description="{Binding DeleteDescription}"
                                            Command="{Binding DeleteAllConfigurationsCommand}" AutomationProperties.AutomationId="SettingsDeleteAllButton" />
                    </controls:Stack>
                </controls:Section>
            </controls:Stack>
        </controls:AdaptiveColumns>
    </controls:ScreenPage>
</UserControl>
