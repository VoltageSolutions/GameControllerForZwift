<UserControl x:Class="GameControllerForZwift.UI.WPF.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
             xmlns:vm="clr-namespace:GameControllerForZwift.UI.WPF.ViewModels"
             AutomationProperties.AutomationId="SettingsPage">
    <!-- docs/spec/screens/settings.md -->
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" Text="{loc:Loc SettingsTitle}"
                   AutomationProperties.AutomationId="SettingsPageTitle" AutomationProperties.HeadingLevel="Level1" />

        <!-- Appearance (SCR-SET-001) -->
        <TextBlock Margin="0,24,0,8" Style="{StaticResource Text.BodyStrong}" Text="{loc:Loc SettingsAppearanceSection}" AutomationProperties.HeadingLevel="Level2" />
        <Border Style="{StaticResource Surface.Card}">
            <ComboBox x:Name="AppearancePicker" HorizontalAlignment="Left" MinWidth="280"
                      ItemsSource="{x:Static vm:SettingsViewModel.AppearanceOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Appearance}"
                      AutomationProperties.AutomationId="SettingsAppearanceGroup" AutomationProperties.Name="{loc:Loc SettingsAppearanceSection}" />
        </Border>

        <!-- Rides: the ride timeout (SCR-SET-012, SCR-SET-013) -->
        <TextBlock Margin="0,24,0,8" Style="{StaticResource Text.BodyStrong}" Text="{loc:Loc SettingsRidesSection}" AutomationProperties.HeadingLevel="Level2" />
        <Border Style="{StaticResource Surface.Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Body}" Text="{loc:Loc SettingsRideTimeout}" />
                <TextBlock Margin="0,4,0,12" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{loc:Loc SettingsRideTimeoutDescription}" />
                <TextBox x:Name="RideTimeoutBox" HorizontalAlignment="Left" Width="120"
                         Text="{Binding RideTimeoutText, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.AutomationId="SettingsRideTimeoutInput" AutomationProperties.Name="{loc:Loc SettingsRideTimeout}" />
                <TextBlock x:Name="RideTimeoutMessage" Margin="0,8,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.accent-ink}" Text="{Binding RideTimeoutMessage}"
                           Visibility="{Binding HasRideTimeoutMessage, Converter={StaticResource BooleanToVisibility}}"
                           AutomationProperties.AutomationId="SettingsRideTimeoutMessage" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <!-- Mappings (SCR-SET-003 to SCR-SET-005) -->
        <TextBlock Margin="0,24,0,8" Style="{StaticResource Text.BodyStrong}" Text="{loc:Loc SettingsMappingsSection}" AutomationProperties.HeadingLevel="Level2" />
        <Border Style="{StaticResource Surface.Card}">
            <StackPanel>
                <Button x:Name="OpenMappingsButton" HorizontalAlignment="Left" Command="{Binding OpenMappingsFolderCommand}"
                        Content="{loc:Loc SettingsOpenMappings}" AutomationProperties.AutomationId="SettingsOpenMappingsButton" />
                <Button x:Name="DeleteAllButton" Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding DeleteAllConfigurationsCommand}"
                        Content="{loc:Loc SettingsDeleteAll}" AutomationProperties.AutomationId="SettingsDeleteAllButton" />
                <TextBlock x:Name="DeleteDescription" Margin="0,8,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           Text="{Binding DeleteDescription}" AutomationProperties.AutomationId="SettingsDeleteDescription" />
            </StackPanel>
        </Border>

        <!-- Help (SCR-SET-006, SCR-SET-007) -->
        <TextBlock Margin="0,24,0,8" Style="{StaticResource Text.BodyStrong}" Text="{loc:Loc SettingsHelpSection}" AutomationProperties.HeadingLevel="Level2" />
        <Border Style="{StaticResource Surface.Card}">
            <StackPanel>
                <Button x:Name="OpenLogsButton" HorizontalAlignment="Left" Command="{Binding OpenLogsFolderCommand}"
                        Content="{loc:Loc SettingsOpenLogs}" AutomationProperties.AutomationId="SettingsOpenLogsButton" />
                <Button x:Name="HelpLinkButton" Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding OpenHelpCommand}"
                        Content="{loc:Loc SettingsHelpLinkText}" AutomationProperties.AutomationId="SettingsHelpLink" />
            </StackPanel>
        </Border>

        <!-- About (SCR-SET-008) -->
        <TextBlock Margin="0,24,0,8" Style="{StaticResource Text.BodyStrong}" Text="{loc:Loc SettingsAboutSection}" AutomationProperties.HeadingLevel="Level2" />
        <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock x:Name="VersionText" Style="{StaticResource Text.Body}" Text="{Binding VersionText}"
                           AutomationProperties.AutomationId="SettingsVersion" />
                <Button x:Name="CreditsLinkButton" Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding OpenCreditsCommand}"
                        Content="{loc:Loc SettingsCreditsLinkText}" AutomationProperties.AutomationId="SettingsCreditsLink" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
