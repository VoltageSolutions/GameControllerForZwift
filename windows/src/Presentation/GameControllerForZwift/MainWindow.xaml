<Window x:Class="GameControllerForZwift.UI.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
    Title="Game Controller for Zwift"
    d:DesignHeight="650"
    d:DesignWidth="1000"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    MinWidth="400"
    MinHeight="450"
    Width="1600" Height="800" Icon="Assets/logo.png"
    Background="{DynamicResource Brush.bg}"
    Foreground="{DynamicResource Brush.text}"
    FontFamily="{StaticResource Font.Figtree}">
    <!-- The shell: three tabs, the More button, and back (docs/spec/ux/navigation.md). -->
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the app name and the window buttons only (UX-N-006). -->
        <Grid Grid.Row="0" Background="{DynamicResource Brush.bg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="14" Height="14" Fill="{DynamicResource Brush.accent}" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Brush.muted}"
                           Text="VOLTAGE · Game Controller for Zwift" />
            </StackPanel>
            <Button x:Name="MinimizeButton" Grid.Column="1" Style="{StaticResource CaptionButton}" Click="MinimizeWindow"
                    AutomationProperties.Name="Minimize" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Text="&#xE921;" />
            </Button>
            <Button x:Name="MaximizeButton" Grid.Column="2" Style="{StaticResource CaptionButton}" Click="MaximizeWindow"
                    AutomationProperties.Name="Maximize" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock x:Name="MaximizeIcon" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Text="&#xE922;" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CaptionCloseButton}" Click="CloseWindow"
                    AutomationProperties.Name="Close" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="10" Text="&#xE8BB;" />
            </Button>
        </Grid>

        <Grid x:Name="ShellGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Focus order is the More button, the menu, the content, then the tabs (UX-A-020). Panel.ZIndex keeps the
                 floating parts on top. -->
            <!-- More button: floats at the top right of the content area and never moves (UX-N-004, UX-N-007). -->
            <controls:MoreMenuButton x:Name="MoreButton" Panel.ZIndex="3" IsExpanded="{Binding ViewModel.IsMoreMenuOpen, Mode=OneWay}" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding ViewModel.ToggleMoreMenuCommand}"
                    AutomationProperties.AutomationId="MenuButton" AutomationProperties.Name="{Binding ViewModel.MoreButtonName}">
                <controls:MoreMenuButton.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MoreButton}">
                        <Setter Property="Margin" Value="0,12,24,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="Rail">
                                <Setter Property="Margin" Value="0,12,16,0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="BottomBar">
                                <Setter Property="Margin" Value="0,12,16,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:MoreMenuButton.Style>
                <Grid>
                    <Path x:Name="MoreIcon" Width="24" Height="24" Data="{StaticResource IconFill.More}" Fill="{DynamicResource Brush.bg}"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsMoreMenuOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.84" ScaleY="0.84" />
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="CloseIcon" Data="{StaticResource Icon.Close}" Width="24" Height="24" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Brush.bg}"
                          Visibility="{Binding ViewModel.IsMoreMenuOpen, Converter={StaticResource BooleanToVisibility}}"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </controls:MoreMenuButton>

            <!-- The More menu covers everything below the title bar, behind a scrim that closes it. -->
            <Grid x:Name="MoreMenuLayer" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="2"
                  Visibility="{Binding ViewModel.IsMoreMenuOpen, Converter={StaticResource BooleanToVisibility}}">
                <Border x:Name="MenuScrim" Background="{DynamicResource Brush.scrim}" MouseLeftButtonDown="MenuScrim_MouseLeftButtonDown" />
                <StackPanel x:Name="MoreMenu" HorizontalAlignment="Right" VerticalAlignment="Top"
                            AutomationProperties.AutomationId="MoreMenu" AutomationProperties.Name="More"
                            KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <!-- The menu opens downward from the More button and lines up with its right edge. -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="0,72,24,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="Rail">
                                    <Setter Property="Margin" Value="0,72,16,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="BottomBar">
                                    <Setter Property="Margin" Value="0,72,16,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <controls:MenuPillButton x:Name="MenuSettingsItem" Style="{StaticResource MenuPill}" Command="{Binding ViewModel.OpenSettingsCommand}"
                            AutomationProperties.AutomationId="MenuSettingsItem" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Settings}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Settings" />
                        </StackPanel>
                    </controls:MenuPillButton>
                    <controls:MenuPillButton x:Name="MenuHelpItem" Style="{StaticResource MenuPill}" Command="{Binding ViewModel.OpenHelpCommand}"
                            AutomationProperties.AutomationId="MenuHelpItem" AutomationProperties.Name="Help and feedback">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="1,0">
                                <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Help}" />
                            </Viewbox>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Help and feedback" />
                        </StackPanel>
                    </controls:MenuPillButton>
                    <controls:MenuPillButton x:Name="MenuCreditsItem" Style="{StaticResource MenuPill}" Command="{Binding ViewModel.OpenCreditsCommand}"
                            AutomationProperties.AutomationId="MenuCreditsItem" AutomationProperties.Name="Credits">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="1,0">
                                <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Credits}" />
                            </Viewbox>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Credits" />
                        </StackPanel>
                    </controls:MenuPillButton>
                    <controls:MenuPillButton x:Name="MenuSupportItem" Style="{StaticResource MenuPill}" Command="{Binding ViewModel.OpenSupportCommand}"
                            AutomationProperties.AutomationId="MenuSupportItem" AutomationProperties.Name="Support this project">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="2,0">
                                <Path Width="24" Height="24" Data="{StaticResource IconFill.Support}" Fill="{DynamicResource Brush.accent-ink}" />
                            </Viewbox>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Support this project" />
                        </StackPanel>
                    </controls:MenuPillButton>
                </StackPanel>
            </Grid>

            <!-- The content area. A pushed screen shows a back button above its content (UX-N-016). -->
            <Grid x:Name="ContentArea" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="48,24,48,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="Rail">
                                <Setter Property="Margin" Value="32,24,32,0" />
                            </DataTrigger>
                            <!-- The bottom bar floats over the content, so the content stops above it. -->
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="BottomBar">
                                <Setter Property="Margin" Value="20,20,20,88" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Button x:Name="BackButton" Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Left"
                        Style="{StaticResource BackButton}" Command="{Binding ViewModel.BackCommand}"
                        AutomationProperties.AutomationId="NavBackButton" AutomationProperties.Name="Back"
                        Visibility="{Binding ViewModel.IsPushedScreen, Converter={StaticResource BooleanToVisibility}}">
                    <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Back}" />
                </Button>

                <ContentControl x:Name="RootContent" Grid.Row="1" IsTabStop="False" Focusable="False" />
            </Grid>

            <!-- Wide window: sidebar with icons and labels. -->
            <Border x:Name="NavSidebar" Grid.Column="0" Width="240" Padding="12,16" Background="{DynamicResource Brush.surface-2}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="Sidebar">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:NavTabList x:Name="SidebarTabs" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavSidebarItem}"
                         AutomationProperties.AutomationId="NavSidebar"
                         ItemsSource="{Binding ViewModel.Tabs}" SelectedItem="{Binding ViewModel.SelectedTab, Mode=TwoWay}" />
            </Border>

            <!-- Medium window: compact rail. -->
            <Border x:Name="NavRail" Grid.Column="0" Width="112" Padding="0,24,0,0" Background="{DynamicResource Brush.surface-2}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="Rail">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:NavTabList x:Name="RailTabs" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavRailItem}"
                         AutomationProperties.AutomationId="NavRail"
                         ItemsSource="{Binding ViewModel.Tabs}" SelectedItem="{Binding ViewModel.SelectedTab, Mode=TwoWay}" />
            </Border>

            <!-- Narrow window: floating bottom bar, full width. -->
            <Border x:Name="NavBottomBar" Panel.ZIndex="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="12,0,12,16" Padding="4"
                    CornerRadius="32" Background="{DynamicResource Brush.surface-2}" Effect="{DynamicResource Effect.shadow}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="BottomBar">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:NavTabList x:Name="BottomTabs" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavBottomItem}"
                         AutomationProperties.AutomationId="NavBottomBar"
                         ItemsSource="{Binding ViewModel.Tabs}" SelectedItem="{Binding ViewModel.SelectedTab, Mode=TwoWay}">
                    <controls:NavTabList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </controls:NavTabList.ItemsPanel>
                </controls:NavTabList>
            </Border>
        </Grid>
    </Grid>
</Window>
