<Window x:Class="GameControllerForZwift.UI.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:GameControllerForZwift.UI.WPF.Controls"
    xmlns:loc="clr-namespace:GameControllerForZwift.UI.WPF.Localization"
    Title="{loc:Loc WindowTitle}"
    d:DesignHeight="650"
    d:DesignWidth="1000"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    Icon="Assets/logo.png"
    Background="{DynamicResource Brush.bg}"
    Foreground="{DynamicResource Brush.text}"
    FontFamily="{StaticResource Font.Figtree}">
    <!-- The shell: three tabs, the More button, and back (docs/spec/ux/navigation.md). -->
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Size.TitleBarHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the app name and the window buttons only (UX-N-006). -->
        <Grid Grid.Row="0" Background="{DynamicResource Brush.bg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource Shell.TitleBarBrand}">
                <Ellipse Style="{StaticResource Shell.TitleBarDot}" />
                <TextBlock Style="{StaticResource Shell.TitleBarName}" Text="{loc:Loc TitleBarText}" />
            </StackPanel>
            <Button x:Name="MinimizeButton" Grid.Column="1" Style="{StaticResource CaptionButton}" Click="MinimizeWindow"
                    AutomationProperties.Name="{loc:Loc CaptionMinimize}" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Style="{StaticResource Shell.CaptionGlyph}" Text="&#xE921;" />
            </Button>
            <Button x:Name="MaximizeButton" Grid.Column="2" Style="{StaticResource CaptionButton}" Click="MaximizeWindow"
                    AutomationProperties.Name="{loc:Loc CaptionMaximize}" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock x:Name="MaximizeIcon" Style="{StaticResource Shell.CaptionGlyph}" Text="&#xE922;" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CaptionCloseButton}" Click="CloseWindow"
                    AutomationProperties.Name="{loc:Loc CaptionClose}" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Style="{StaticResource Shell.CaptionGlyph}" Text="&#xE8BB;" />
            </Button>
        </Grid>

        <Grid x:Name="ShellGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Focus and reading order follow a left-to-right layout (UX-A-020): the sidebar or rail, the More button, the
                 menu, the content, then the bottom bar. Only one tab placement is visible at a time. Panel.ZIndex keeps
                 the floating parts on top. -->
            <!-- Wide window: sidebar with icons and labels. -->
            <Border x:Name="NavSidebar" Grid.Column="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Shell.Sidebar}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="Sidebar">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:NavTabList x:Name="SidebarTabs" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavSidebarItem}"
                         AutomationProperties.AutomationId="NavSidebar"
                         ItemsSource="{Binding ViewModel.Tabs}" SelectedItem="{Binding ViewModel.SelectedTab, Mode=TwoWay}" />
            </Border>

            <!-- Medium window: compact rail. -->
            <Border x:Name="NavRail" Grid.Column="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Shell.Rail}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="Rail">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:NavTabList x:Name="RailTabs" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavRailItem}"
                         AutomationProperties.AutomationId="NavRail"
                         ItemsSource="{Binding ViewModel.Tabs}" SelectedItem="{Binding ViewModel.SelectedTab, Mode=TwoWay}" />
            </Border>

            <!-- More button: floats at the top right of the content area and never moves (UX-N-004, UX-N-007). -->
            <controls:MoreMenuButton x:Name="MoreButton" Panel.ZIndex="1" IsExpanded="{Binding ViewModel.IsMoreMenuOpen, Mode=OneWay}" Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource MoreButton}" Margin="{DynamicResource Layout.MoreMargin}"
                    Command="{Binding ViewModel.ToggleMoreMenuCommand}"
                    AutomationProperties.AutomationId="MenuButton" AutomationProperties.Name="{Binding ViewModel.MoreButtonName}">
                <Grid>
                    <Path x:Name="MoreIcon" Data="{StaticResource IconFill.More}">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource Shell.MoreIcon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsMoreMenuOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Path x:Name="CloseIcon" Style="{StaticResource Shell.CloseIcon}" Data="{StaticResource Icon.Close}"
                          Visibility="{Binding ViewModel.IsMoreMenuOpen, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </controls:MoreMenuButton>

            <!-- The More menu covers everything below the title bar, navigation and the More button included, behind a scrim
                 that closes it (UX-N-013). -->
            <Grid x:Name="MoreMenuLayer" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="4"
                  Visibility="{Binding ViewModel.IsMoreMenuOpen, Converter={StaticResource BooleanToVisibility}}">
                <Border x:Name="MenuScrim" Background="{DynamicResource Brush.scrim}" MouseLeftButtonDown="MenuScrim_MouseLeftButtonDown" />
                <controls:Stack x:Name="MoreMenu" HorizontalAlignment="Right" VerticalAlignment="Top" Gap="{StaticResource Space.8}"
                            Margin="{DynamicResource Layout.MenuMargin}"
                            AutomationProperties.AutomationId="MoreMenu" AutomationProperties.Name="{loc:Loc MenuName}"
                            KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <!-- The menu opens downward from the More button and lines up with its right edge. -->
                    <controls:MenuPillButton x:Name="MenuSettingsItem" Style="{StaticResource MenuPill}" Command="{Binding ViewModel.OpenSettingsCommand}"
                            AutomationProperties.AutomationId="MenuSettingsItem" AutomationProperties.Name="{loc:Loc MenuSettings}">
                        <controls:Stack Orientation="Horizontal" Gap="{StaticResource Space.12}">
                            <Viewbox Style="{StaticResource Shell.MenuIcon}">
                                <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Settings}" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="{loc:Loc MenuSettings}" />
                        </controls:Stack>
                    </controls:MenuPillButton>
                    <controls:MenuPillButton x:Name="MenuHelpItem" Style="{StaticResource MenuPill}" Command="{Binding ViewModel.OpenHelpCommand}"
                            AutomationProperties.AutomationId="MenuHelpItem" AutomationProperties.Name="{loc:Loc MenuHelp}">
                        <controls:Stack Orientation="Horizontal" Gap="{StaticResource Space.12}">
                            <Viewbox Style="{StaticResource Shell.MenuIcon}">
                                <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Help}" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="{loc:Loc MenuHelp}" />
                        </controls:Stack>
                    </controls:MenuPillButton>
                    <controls:MenuPillButton x:Name="MenuCreditsItem" Style="{StaticResource MenuPill}" Command="{Binding ViewModel.OpenCreditsCommand}"
                            AutomationProperties.AutomationId="MenuCreditsItem" AutomationProperties.Name="{loc:Loc MenuAbout}">
                        <controls:Stack Orientation="Horizontal" Gap="{StaticResource Space.12}">
                            <Viewbox Style="{StaticResource Shell.MenuIcon}">
                                <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Credits}" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="{loc:Loc MenuAbout}" />
                        </controls:Stack>
                    </controls:MenuPillButton>
                    <controls:MenuPillButton x:Name="MenuSupportItem" Style="{StaticResource MenuPill}" Command="{Binding ViewModel.OpenSupportCommand}"
                            AutomationProperties.AutomationId="MenuSupportItem" AutomationProperties.Name="{loc:Loc MenuSupport}">
                        <controls:Stack Orientation="Horizontal" Gap="{StaticResource Space.12}">
                            <Viewbox Style="{StaticResource Shell.MenuIcon}">
                                <Path Style="{StaticResource Shell.MenuIconFill}" Data="{StaticResource IconFill.Support}" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="{loc:Loc MenuSupport}" />
                        </controls:Stack>
                    </controls:MenuPillButton>
                    <!-- Debug builds only: every component in each state, for development (docs/spec/ux/navigation.md). -->
                    <controls:MenuPillButton x:Name="MenuStyleGalleryItem" Style="{StaticResource MenuPill}" Command="{Binding ViewModel.OpenStyleGalleryCommand}"
                            AutomationProperties.AutomationId="MenuStyleGalleryItem" AutomationProperties.Name="{loc:Loc MenuStyleGallery}"
                            Visibility="{Binding ViewModel.ShowsStyleGallery, Converter={StaticResource BooleanToVisibility}}">
                        <controls:Stack Orientation="Horizontal" Gap="{StaticResource Space.12}">
                            <Viewbox Style="{StaticResource Shell.MenuIcon}">
                                <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Gallery}" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="{loc:Loc MenuStyleGallery}" />
                        </controls:Stack>
                    </controls:MenuPillButton>
                </controls:Stack>
            </Grid>

            <!-- The content area. The page owns its margins (UX-V-051). A pushed screen shows a back button above its
                 content (UX-N-016). -->
            <Grid x:Name="ContentArea" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="BackButton" Grid.Row="0" HorizontalAlignment="Left" Margin="{DynamicResource Layout.BackMargin}"
                        Style="{StaticResource BackButton}" Command="{Binding ViewModel.BackCommand}"
                        AutomationProperties.AutomationId="NavBackButton" AutomationProperties.Name="{loc:Loc NavBack}"
                        Visibility="{Binding ViewModel.IsPushedScreen, Converter={StaticResource BooleanToVisibility}}">
                    <Path Style="{StaticResource IconStroke}" Data="{StaticResource Icon.Back}" />
                </Button>

                <ContentControl x:Name="RootContent" Grid.Row="1" IsTabStop="False" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>

            <!-- Narrow window: floating bottom bar, full width. -->
            <Border x:Name="NavBottomBar" Panel.ZIndex="1" Grid.Column="0" Grid.ColumnSpan="2">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Shell.BottomBar}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.NavLayout}" Value="BottomBar">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:NavTabList x:Name="BottomTabs" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavBottomItem}"
                         AutomationProperties.AutomationId="NavBottomBar"
                         ItemsSource="{Binding ViewModel.Tabs}" SelectedItem="{Binding ViewModel.SelectedTab, Mode=TwoWay}">
                    <controls:NavTabList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </controls:NavTabList.ItemsPanel>
                </controls:NavTabList>
            </Border>

            <!-- Sheets and dialogs that belong to a page are shown here, above the navigation and the More button
                 (UX-N-013). -->
            <Grid x:Name="OverlayHost" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="5" />
        </Grid>
    </Grid>
</Window>
